# Project Atlas - Environment Configuration

# Database URLs
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas_dev?schema=public"
DATABASE_TEST_URL="postgresql://atlas:atlas@localhost:5433/atlas_test?schema=public"

# Node Environment
NODE_ENV="development"

# Security & Authentication Secrets (Change in production!)
JWT_ACCESS_SECRET="dev-jwt-access-secret-32-chars-long-atlas-invest"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER="dev-refresh-token-pepper-32-chars-long-atlas"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_PEPPER="dev-password-reset-pepper-32-chars-long-atlas"
PASSWORD_RESET_TTL_MINUTES=15

# Market Data Provider Configuration
MARKET_DATA_PROVIDER="BRAPI"
MARKET_DATA_TIMEOUT_MS=10000
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_DATA_MAX_BATCH=100

# Historical Market Data Provider Configuration
HISTORICAL_MARKET_DATA_PROVIDER="BRAPI"
HISTORICAL_MARKET_DATA_TIMEOUT_MS=15000
HISTORICAL_MARKET_DATA_MAX_LOOKBACK_DAYS=7

# Benchmark Data Provider Configuration
BENCHMARK_DATA_PROVIDER="yahoo"
BENCHMARK_DATA_TIMEOUT_MS=15000
BENCHMARK_DATA_MAX_LOOKBACK_DAYS=7

# Rate Benchmark (CDI) Provider Configuration
# BCB SGS 12 is a public API and requires no token/credentials.
RATE_BENCHMARK_DATA_PROVIDER="bcb"
RATE_BENCHMARK_DATA_TIMEOUT_MS=15000

# Remote Owner MVP & Operational Configuration
ALLOW_PUBLIC_REGISTRATION="false"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
APP_VERSION="0.1.0"
GIT_COMMIT_SHA="development"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3001"

# Verified-evidence tax-cost enrichment (CTE). Local owner activation only.
#TAX_COST_EVIDENCE_ENRICHMENT_ENABLED=false
