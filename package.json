{
  "name": "atlas-invest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @atlas/mobile dev",
    "dev:web": "pnpm --filter @atlas/web dev",
    "dev:api": "pnpm --filter @atlas/api dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --config vitest.domain.config.ts && vitest run --config vitest.database.config.ts && vitest run --config vitest.api.config.ts && vitest run --config vitest.foundation.config.ts",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:database": "vitest run --config vitest.database.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:foundation": "vitest run --config vitest.foundation.config.ts",
    "db:generate": "pnpm --filter @atlas/database generate",
    "db:migrate": "pnpm --filter @atlas/database migrate",
    "db:seed": "pnpm --filter @atlas/database seed",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@types/supertest": "^6.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/testing": "^11.0.11",
    "reflect-metadata": "^0.2.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
