# ============================================================================
# Project Atlas — Production Environment Template (.env.production.example)
# Architecture: ADR-290 (Linux VPS + Managed PostgreSQL 16)
# Instructions: Copy to .env.production on the server and populate secrets.
# NEVER commit real credentials, passwords, or pepper keys to Git!
# ============================================================================

# Environment & Runtime
NODE_ENV="production"
PORT=3001
LOG_LEVEL="info"
APP_VERSION="0.1.0"
GIT_COMMIT_SHA="beta-release"

# Managed PostgreSQL 16 Connection (Private VPC endpoint, SSL enforced)
# Format: postgresql://<USER>:<PASSWORD>@<PRIVATE_HOST>:5432/<DB_NAME>?schema=public&sslmode=require
DATABASE_URL="postgresql://atlas_user:CHANGE_ME_STRONG_DATABASE_PASSWORD@database.internal.atlasinvest.com.br:5432/atlas_beta?schema=public&sslmode=require"

# Security & Authentication Secrets (MUST be >= 32 characters, cryptographically random)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHICALLY_RANDOM_SECRET"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER="CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHICALLY_RANDOM_PEPPER"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_PEPPER="CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHICALLY_RANDOM_PEPPER"
PASSWORD_RESET_TTL_MINUTES=15

# Transactional Email Provider (ADR-290 / Phase 6D)
# Production requires a valid provider (RESEND or SMTP). In-memory fallback is strictly prohibited.
# Option 1: RESEND (Recommended)
EMAIL_PROVIDER="RESEND"
RESEND_API_KEY="re_CHANGE_ME_PRODUCTION_API_KEY"
# EMAIL_API_KEY="" # Alternative fallback alias for RESEND_API_KEY
EMAIL_FROM="Atlas Invest <no-reply@atlasinvest.com.br>"

# Option 2: SMTP (Alternative)
# EMAIL_PROVIDER="SMTP"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"
# SMTP_SECURE="false"
# EMAIL_FROM="Atlas Invest <no-reply@atlasinvest.com.br>"

# Reverse Proxy & Host Configuration (ADR-290)
# Mode: STAGING_IP_ONLY_HTTP_TEMPORARY
# Temporary staging uses static IPv4 via plain HTTP without ACME / TLS certificates.
STAGING_HOST="54.233.66.110"
# Future production domain configuration:
# APP_DOMAIN="app.atlasinvest.com.br"
# API_DOMAIN="api.atlasinvest.com.br"

# Access Control & CORS
# Restricted to the canonical Web application domain (or staging IP)
ALLOWED_ORIGINS="https://app.atlasinvest.com.br"
# Staging IP-only alternative: ALLOWED_ORIGINS="http://54.233.66.110"
# External beta is invite-only: public self-registration must remain disabled
ALLOW_PUBLIC_REGISTRATION="false"

# Web Client Configuration (Public & Internal BFF)
NEXT_PUBLIC_APP_URL="https://app.atlasinvest.com.br"
NEXT_PUBLIC_API_URL="https://api.atlasinvest.com.br"
# Internal routing inside Docker network bridge (prevents hairpinned internet latency)
ATLAS_API_INTERNAL_URL="http://api:3001"
API_BASE_URL="http://api:3001"

# Temporary staging-only override for HTTP/IP access.
# MUST remain false in production/HTTPS.
ALLOW_INSECURE_HTTP_AUTH_COOKIES=false

# Temporary staging-only override for plain HTTP/IP access.
# MUST remain false in HTTPS/production.
DISABLE_HSTS_FOR_HTTP_STAGING=false

# Feature Flags (Controlled Beta Rollout)
# Tax evidence enrichment: false for initial beta until first real disposal is validated
TAX_COST_EVIDENCE_ENRICHMENT_ENABLED="false"
# Background scheduler: false for initial beta (manual B3 XLSX/CSV upload fallback)
INTEGRATION_SCHEDULER_ENABLED="false"

# Market & Benchmark Data Providers
MARKET_DATA_PROVIDER="BRAPI"
MARKET_DATA_TIMEOUT_MS=10000
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_DATA_MAX_BATCH=100

HISTORICAL_MARKET_DATA_PROVIDER="BRAPI"
HISTORICAL_MARKET_DATA_TIMEOUT_MS=15000
HISTORICAL_MARKET_DATA_MAX_LOOKBACK_DAYS=7

BENCHMARK_DATA_PROVIDER="yahoo"
BENCHMARK_DATA_TIMEOUT_MS=15000
BENCHMARK_DATA_MAX_LOOKBACK_DAYS=7

RATE_BENCHMARK_DATA_PROVIDER="bcb"
RATE_BENCHMARK_DATA_TIMEOUT_MS=15000

# AI & Contextual Intelligence Provider (Phase 3R / ADR-180 / ADR-184)
# In production/staging (NODE_ENV=production), a valid real provider is strictly required.
# Fallback to FakeAiProvider is strictly prohibited in production and will cause bootstrap to abort.
# NEVER commit real API keys to version control!
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-CHANGE_ME_PRODUCTION_OPENAI_API_KEY"
AI_MODEL="gpt-4o-mini"
