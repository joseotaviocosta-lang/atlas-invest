datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  name            String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  locale          String    @default("pt-BR") @db.VarChar(10)
  timezone        String    @default("America/Sao_Paulo") @db.VarChar(50)
  baseCurrency    String    @default("BRL") @map("base_currency") @db.VarChar(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolios          Portfolio[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  aiConversations     AiConversation[]
  taxTradeClassifications TaxTradeClassificationRecord[]
  taxWithholdingInputs    TaxWithholdingInputRecord[]
  fiiTaxEligibilityFacts  FiiTaxEligibilityFactRecord[]

  @@map("users")
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @map("refresh_token_hash") @db.VarChar(255)
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(255)
  usedRefreshTokenHashes   String[]  @default([]) @map("used_refresh_token_hashes")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent                String?   @map("user_agent") @db.VarChar(500)
  ipHash                   String?   @map("ip_hash") @db.VarChar(64)
  deviceName               String?   @map("device_name") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  country   String   @db.VarChar(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@map("institutions")
}

model Portfolio {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  baseCurrency String   @map("base_currency") @db.VarChar(3)
  type         String   @db.VarChar(50)
  status       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        Account[]
  transactions    Transaction[]
  aiConversations AiConversation[]

  @@index([userId])
  @@map("portfolios")
}

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String   @db.VarChar(255)
  currency      String   @db.VarChar(3)
  status        String   @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio   Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([id, portfolioId])
  @@index([portfolioId])
  @@index([institutionId])
  @@map("accounts")
}

model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  ticker    String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  currency  String   @db.VarChar(3)
  exchange  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions            Transaction[]
  marketIntelligenceLinks MarketIntelligenceAssetLink[]
  fiiTaxEligibilityFacts  FiiTaxEligibilityFactRecord[]

  @@unique([ticker, exchange])
  @@index([ticker])
  @@map("assets")
}

model Transaction {
  id             String    @id @default(uuid()) @db.Uuid
  portfolioId    String    @map("portfolio_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  assetId        String?   @map("asset_id") @db.Uuid
  type           String    @db.VarChar(50)
  tradeDate      DateTime  @map("trade_date") @db.Date
  settlementDate DateTime? @map("settlement_date") @db.Date
  source         String    @default("MANUAL") @db.VarChar(50)
  quantity       Decimal?  @db.Decimal(38, 18)
  unitPrice      Decimal?  @map("unit_price") @db.Decimal(38, 18)
  amount         Decimal?  @db.Decimal(38, 18)
  currency       String    @db.VarChar(3)
  fees           Decimal?  @db.Decimal(38, 18)
  taxes          Decimal?  @db.Decimal(38, 18)
  factor         Decimal?  @db.Decimal(38, 18)
  provider       String?   @db.VarChar(100)
  externalId     String?   @map("external_id") @db.VarChar(255)
  notes          String?   @db.Text
  transferGroupId String?  @map("transfer_group_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId, portfolioId], references: [id, portfolioId], onDelete: Restrict)
  asset     Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  taxTradeClassifications TaxTradeClassificationRecord[]

  @@unique([portfolioId, provider, externalId], name: "portfolio_provider_external_id_unique")
  @@index([portfolioId, tradeDate, createdAt, id])
  @@index([portfolioId, accountId])
  @@index([portfolioId, transferGroupId])
  @@index([assetId])
  @@map("transactions")
}

model AiConversation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  title       String?   @db.VarChar(255)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio   Portfolio              @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  messages    AiConversationMessage[]

  @@index([userId])
  @@index([portfolioId])
  @@index([portfolioId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  role              String    @db.VarChar(20)
  content           String    @db.Text
  status            String    @default("ANSWERED") @db.VarChar(50)
  intent            String?   @db.VarChar(100)
  evidenceSnapshot  Json?     @map("evidence_snapshot") @db.JsonB
  claims            Json?     @map("claims") @db.JsonB
  limitations       String[]  @default([]) @map("limitations")
  provider          String?   @db.VarChar(100)
  model             String?   @db.VarChar(100)
  providerRequestId String?   @map("provider_request_id") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("ai_conversation_messages")
}

model MarketIntelligenceItem {
  id             String   @id @default(uuid()) @db.Uuid
  sourceProvider String   @map("source_provider") @db.VarChar(100)
  sourceType     String   @map("source_type") @db.VarChar(50)
  sourceItemId   String   @map("source_item_id") @db.VarChar(255)
  headline       String   @db.VarChar(500)
  excerpt        String?  @db.VarChar(2000)
  canonicalUrl   String?  @map("canonical_url") @db.VarChar(1000)
  publishedAt    DateTime @map("published_at") @db.Timestamptz(6)
  retrievedAt    DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  category       String   @db.VarChar(50)
  language       String   @default("pt-BR") @db.VarChar(10)
  status         String   @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assetLinks MarketIntelligenceAssetLink[]

  @@unique([sourceProvider, sourceItemId], name: "source_provider_item_id_unique")
  @@index([publishedAt])
  @@index([category])
  @@map("market_intelligence_items")
}

model MarketIntelligenceAssetLink {
  id                       String   @id @default(uuid()) @db.Uuid
  marketIntelligenceItemId String   @map("market_intelligence_item_id") @db.Uuid
  assetId                  String   @map("asset_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item  MarketIntelligenceItem @relation(fields: [marketIntelligenceItemId], references: [id], onDelete: Cascade)
  asset Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([marketIntelligenceItemId, assetId], name: "item_asset_link_unique")
  @@index([assetId])
  @@index([marketIntelligenceItemId])
  @@map("market_intelligence_asset_links")
}

/// Phase 4B.3 — persisted canonical trade classification (auxiliary tax input).
/// References the immutable transaction; never mutates it.
model TaxTradeClassificationRecord {
  id              String    @id @default(uuid()) @db.Uuid
  taxSubjectId    String    @map("tax_subject_id") @db.Uuid
  transactionId   String    @map("transaction_id") @db.Uuid
  classification  String    @db.VarChar(20)
  sourceType      String    @map("source_type") @db.VarChar(50)
  sourceReference String    @map("source_reference") @db.VarChar(255)
  effectiveDate   DateTime  @map("effective_date") @db.Date
  status          String    @db.VarChar(20)
  conflictStatus  String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint     String    @db.VarChar(64)
  provenance      Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject  User        @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, transactionId, sourceReference], name: "tax_trade_classification_identity")
  @@index([taxSubjectId, transactionId])
  @@index([taxSubjectId, effectiveDate])
  @@map("tax_trade_classification_records")
}

/// Phase 4B.3 — persisted canonical withholding/IRRF input (exact decimal).
model TaxWithholdingInputRecord {
  id              String    @id @default(uuid()) @db.Uuid
  taxSubjectId    String    @map("tax_subject_id") @db.Uuid
  competence      String    @db.Char(7)
  economicDate    DateTime  @map("economic_date") @db.Date
  category        String    @db.VarChar(50)
  amount          Decimal?  @db.Decimal(38, 18)
  currency        String    @db.VarChar(3)
  status          String    @db.VarChar(20)
  sourceType      String    @map("source_type") @db.VarChar(50)
  sourceReference String    @map("source_reference") @db.VarChar(255)
  conflictStatus  String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint     String    @db.VarChar(64)
  provenance      Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, sourceType, sourceReference], name: "tax_withholding_identity")
  @@index([taxSubjectId, competence])
  @@index([taxSubjectId, economicDate])
  @@map("tax_withholding_input_records")
}

/// Phase 4B.3 — persisted FII tax-condition metadata (factual input only).
/// User-attested facts scoped to the tax subject; never tax treatment.
model FiiTaxEligibilityFactRecord {
  id                       String    @id @default(uuid()) @db.Uuid
  taxSubjectId             String    @map("tax_subject_id") @db.Uuid
  assetId                  String    @map("asset_id") @db.Uuid
  asOfDate                 DateTime  @map("as_of_date") @db.Date
  holderCount              Int?      @map("holder_count")
  investorOwnershipPercent Decimal?  @map("investor_ownership_percent") @db.Decimal(38, 18)
  isExchangeTraded         Boolean?  @map("is_exchange_traded")
  sourceType               String    @map("source_type") @db.VarChar(50)
  sourceReference          String    @map("source_reference") @db.VarChar(255)
  status                   String    @db.VarChar(20)
  conflictStatus           String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint              String    @db.VarChar(64)
  provenance               Json
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User  @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, assetId, sourceType, sourceReference, asOfDate], name: "fii_tax_eligibility_identity")
  @@index([taxSubjectId, assetId, asOfDate])
  @@map("fii_tax_eligibility_fact_records")
}