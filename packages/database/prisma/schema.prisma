datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  name            String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  locale          String    @default("pt-BR") @db.VarChar(10)
  timezone        String    @default("America/Sao_Paulo") @db.VarChar(50)
  baseCurrency    String    @default("BRL") @map("base_currency") @db.VarChar(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  deactivatedAt            DateTime? @map("deactivated_at") @db.Timestamptz(6)

  portfolios               Portfolio[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  aiConversations          AiConversation[]
  taxTradeClassifications  TaxTradeClassificationRecord[]
  taxWithholdingInputs     TaxWithholdingInputRecord[]
  fiiTaxEligibilityFacts   FiiTaxEligibilityFactRecord[]
  taxObligations           TaxObligationRecord[]
  taxPaymentEvidence       TaxPaymentEvidenceRecord[]
  taxCarryForwardEntries   TaxCarryForwardEntry[]
  taxPaymentAggregations   TaxPaymentAggregation[]
  taxpayerIdentity         TaxpayerIdentityRecord?
  darfGenerationRecords    OfficialDarfGenerationRecord[]
  taxCompensationElections TaxCompensationElectionRecord[]
  annualOpeningPositions   AnnualOpeningPositionInputRecord[]
  taxpayerConfirmations    TaxpayerConfirmationRecord[]
  highIncomeEvidence       HighIncomeEvidenceRecord[]
  taxComplianceActions     TaxComplianceActionRecord[]
  taxSettlementRecords     TaxSettlementRecord[]
  taxReminderActions       TaxComplianceReminderActionRecord[]
  taxNotificationEvents    TaxComplianceNotificationEventRecord[]
  taxReminderPreferences   TaxComplianceReminderPreferenceRecord?
  taxPeriodCloseRecords    TaxCompliancePeriodCloseRecord[]
  watchlistItems           WatchlistItem[]
  legalDocumentAcceptances LegalDocumentAcceptance[]
  userConsents             UserConsent[]
  dataSubjectRequests      DataSubjectRequest[]

  @@map("users")
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @map("refresh_token_hash") @db.VarChar(255)
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(255)
  usedRefreshTokenHashes   String[]  @default([]) @map("used_refresh_token_hashes")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent                String?   @map("user_agent") @db.VarChar(500)
  ipHash                   String?   @map("ip_hash") @db.VarChar(64)
  deviceName               String?   @map("device_name") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  country   String   @db.VarChar(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@map("institutions")
}

model Portfolio {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  baseCurrency String   @map("base_currency") @db.VarChar(3)
  type         String   @db.VarChar(50)
  status       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts               Account[]
  transactions           Transaction[]
  integrationRuns        IntegrationRun[]
  integrationSchedules   IntegrationSchedule[]
  integrationConnections IntegrationConnection[]
  allocationStrategyTargets PortfolioAllocationStrategyTarget[]
  allocationScenarios         PortfolioAllocationScenario[]
  contributionPlans           PortfolioContributionPlan[]
  contributionGoals           PortfolioContributionGoal[]
  aiConversations        AiConversation[]
  annualOpeningPositions AnnualOpeningPositionInputRecord[]
  reconciliationDecisions ReconciliationDecisionRecord[]
  transactionRectifications TransactionRectificationRecord[]
  costBasisEvidence      CostBasisEvidenceRecord[]
  newsSyncState          PortfolioNewsSyncState?
  newsEventStates        PortfolioNewsEventStateRecord[]

  @@index([userId])
  @@map("portfolios")
}

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String   @db.VarChar(255)
  currency      String   @db.VarChar(3)
  status        String   @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio              Portfolio                          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  institution            Institution                        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactions           Transaction[]
  annualOpeningPositions AnnualOpeningPositionInputRecord[]
  costBasisEvidence      CostBasisEvidenceRecord[]

  @@unique([id, portfolioId])
  @@index([portfolioId])
  @@index([institutionId])
  @@map("accounts")
}

model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  ticker    String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  currency  String   @db.VarChar(3)
  exchange  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions            Transaction[]
  marketIntelligenceLinks MarketIntelligenceAssetLink[]
  fiiTaxEligibilityFacts  FiiTaxEligibilityFactRecord[]
  annualOpeningPositions  AnnualOpeningPositionInputRecord[]
  costBasisEvidence       CostBasisEvidenceRecord[]
  marketQuotes            MarketQuoteRecord[]
  watchlistItems          WatchlistItem[]

  @@unique([ticker, exchange])
  @@index([ticker])
  @@map("assets")
}

model Transaction {
  id              String    @id @default(uuid()) @db.Uuid
  portfolioId     String    @map("portfolio_id") @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  type            String    @db.VarChar(50)
  tradeDate       DateTime  @map("trade_date") @db.Date
  settlementDate  DateTime? @map("settlement_date") @db.Date
  source          String    @default("MANUAL") @db.VarChar(50)
  quantity        Decimal?  @db.Decimal(38, 18)
  unitPrice       Decimal?  @map("unit_price") @db.Decimal(38, 18)
  amount          Decimal?  @db.Decimal(38, 18)
  currency        String    @db.VarChar(3)
  fees            Decimal?  @db.Decimal(38, 18)
  taxes           Decimal?  @db.Decimal(38, 18)
  factor          Decimal?  @db.Decimal(38, 18)
  provider        String?   @db.VarChar(100)
  externalId      String?   @map("external_id") @db.VarChar(255)
  notes           String?   @db.Text
  transferGroupId String?   @map("transfer_group_id") @db.VarChar(255)
  // RECEIPT_CONVERSION cross-asset references (all other types keep NULL).
  targetAssetId   String?   @map("target_asset_id") @db.Uuid
  targetQuantity  Decimal?  @map("target_quantity") @db.Decimal(38, 18)
  conversionRatio Decimal?  @map("conversion_ratio") @db.Decimal(38, 18)
  conversionType  String?   @map("conversion_type") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio               Portfolio                      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account                 Account                        @relation(fields: [accountId, portfolioId], references: [id, portfolioId], onDelete: Restrict)
  asset                   Asset?                         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  taxTradeClassifications TaxTradeClassificationRecord[]
  contributionPlanLinks   ContributionPlanTransactionLink[]
  reconciliationDecisions ReconciliationDecisionRecord[]
  rectificationsAsOriginal      TransactionRectificationRecord[] @relation("RectificationOriginal")
  rectificationsAsCompensating  TransactionRectificationRecord[] @relation("RectificationCompensating")
  rectificationsAsReplacement   TransactionRectificationRecord[] @relation("RectificationReplacement")

  @@unique([portfolioId, provider, externalId], name: "portfolio_provider_external_id_unique")
  @@index([portfolioId, tradeDate, createdAt, id])
  @@index([portfolioId, accountId])
  @@index([portfolioId, transferGroupId])
  @@index([assetId])
  @@index([targetAssetId])
  @@map("transactions")
}

/**
 * Phase 5P-PRE — operational history of import/sync executions.
 * One row per run; canonical events stay in `transactions`, linked via the
 * `integration_run_transactions` link table (the ledger table itself stays
 * byte-identical). Runs are append-mostly and immutable once terminal
 * (COMPLETED/PARTIAL/FAILED). Portfolio deletion cascades (runs are scoped
 * evidence of that portfolio).
 */
model IntegrationRun {
  id                           String    @id @default(uuid()) @db.Uuid
  portfolioId                  String    @map("portfolio_id") @db.Uuid
  source                       String    @db.VarChar(50)
  provider                     String?   @db.VarChar(100)
  environment                  String?   @db.VarChar(50)
  fileName                     String?   @map("file_name") @db.VarChar(255)
  sourceAsOf                   String?   @map("source_as_of") @db.VarChar(10)
  status                       String    @db.VarChar(50)
  recordsFetched               Int       @default(0) @map("records_fetched")
  recordsNormalized            Int       @default(0) @map("records_normalized")
  newCandidates                Int       @default(0) @map("new_candidates")
  exactDuplicates              Int       @default(0) @map("exact_duplicates")
  probableDuplicates           Int       @default(0) @map("probable_duplicates")
  conflicts                    Int       @default(0)
  unsupported                  Int       @default(0)
  invalid                      Int       @default(0)
  confirmed                    Int       @default(0)
  ignored                      Int       @default(0)
  reconciliationMatched        Int?      @map("reconciliation_matched")
  reconciliationDivergent      Int?      @map("reconciliation_divergent")
  reconciliationMissingLocal   Int?      @map("reconciliation_missing_local")
  reconciliationMissingSource  Int?      @map("reconciliation_missing_source")
  reconciliationUnresolved     Int?      @map("reconciliation_unresolved")
  partial                      Boolean   @default(false)
  errorCode                    String?   @map("error_code") @db.VarChar(100)
  errorMessage                 String?   @map("error_message") @db.VarChar(500)
  trigger                      String?   @db.VarChar(20)
  startedAt                    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt                  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  links     IntegrationRunTransaction[]
  reconciliationDecisions ReconciliationDecisionRecord[]

  @@index([portfolioId])
  @@map("integration_runs")
}

/**
 * Phase 5P-PRE — which canonical transactions a run confirmed.
 * Link rows only (run_id, portfolio_id, transaction_id); the ledger stays
 * untouched. Run deletion cascades links; transactions are append-only and
 * never deleted through runs.
 */
model IntegrationRunTransaction {
  runId         String   @map("run_id") @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run IntegrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, transactionId])
  @@index([portfolioId])
  @@index([transactionId])
  @@map("integration_run_transactions")
}

/**
 * Phase 5P-A — scheduled sync foundation: future sync intent.
 * One row per (portfolio, source): what to sync, on which cadence, in which
 * timezone, whether enabled, and when the next occurrence is due. Runs are
 * the executed history (IntegrationRun); schedules are the intent.
 * Environment is CHECK-locked to SIMULATED: enabling CERT/PROD requires a
 * deliberate future migration.
 */
model IntegrationSchedule {
  id           String    @id @default(uuid()) @db.Uuid
  portfolioId  String    @map("portfolio_id") @db.Uuid
  source       String    @db.VarChar(50)
  provider     String    @default("SIMULATED") @db.VarChar(100)
  environment  String    @default("SIMULATED") @db.VarChar(50)
  cadence      String    @db.VarChar(50)
  hourLocal    Int?      @map("hour_local")
  minuteLocal  Int?      @map("minute_local")
  timezone     String    @default("America/Sao_Paulo") @db.VarChar(100)
  enabled      Boolean   @default(false)
  nextRunAt    DateTime? @map("next_run_at") @db.Timestamptz(6)
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastStatus   String?   @map("last_status") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  jobs      IntegrationJob[]

  @@unique([portfolioId, source])
  @@index([enabled, nextRunAt])
  @@map("integration_schedules")
}

/**
 * Phase 5P-A — one row per scheduled occurrence (schedule + slot).
 * Unique per (schedule, slot): duplicate ticks coalesce instead of
 * duplicating. Terminal states are COMPLETED/PARTIAL/FAILED; cross-instance
 * exclusivity comes from atomic claim updates plus PostgreSQL advisory
 * locks held by executors (same pattern as the ingestion job lock).
 */
model IntegrationJob {
  id           String    @id @default(uuid()) @db.Uuid
  scheduleId   String    @map("schedule_id") @db.Uuid
  portfolioId  String    @map("portfolio_id") @db.Uuid
  source       String    @db.VarChar(50)
  environment  String    @default("SIMULATED") @db.VarChar(50)
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  status       String    @db.VarChar(32)
  attempt      Int       @default(1)
  notBeforeAt  DateTime? @map("not_before_at") @db.Timestamptz(6)
  runId        String?   @map("run_id") @db.Uuid
  errorCode    String?   @map("error_code") @db.VarChar(100)
  errorMessage String?   @map("error_message") @db.VarChar(500)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule IntegrationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([runId])
  @@index([portfolioId])
  @@map("integration_jobs")
}

/**
 * Phase 5P-D — persistent integration connection lifecycle: whether a
 * portfolio is connected to a source. One row per (portfolio, source):
 * connection state plus authorization timestamps. Schedules keep
 * representing user preference (independent); runs keep being execution
 * history. Environment is CHECK-locked to SIMULATED like schedules:
 * CERT/PROD requires a deliberate future migration. Status is CHECK-locked
 * to the lifecycle vocabulary: execution states (SYNCING/SYNCED/PARTIAL)
 * never live here. No tokens, secrets, certificates, CPF or raw consent
 * payload columns — by design, guarded by tests.
 */
model IntegrationConnection {
  id            String    @id @default(uuid()) @db.Uuid
  portfolioId   String    @map("portfolio_id") @db.Uuid
  source        String    @db.VarChar(50)
  provider      String    @default("SIMULATED") @db.VarChar(100)
  environment   String    @default("SIMULATED") @db.VarChar(50)
  status        String    @db.VarChar(50)
  authorizedAt  DateTime? @map("authorized_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, source])
  @@index([portfolioId])
  @@map("integration_connections")
}

/**
 * Phase 5Q-C — user-defined allocation strategy targets: one row per
 * (portfolio, asset-class category). targetBp is integer basis points
 * (4000 = 40%); the 100%-total invariant is enforced by the application
 * service inside a single replace transaction (cross-row sums cannot be
 * CHECK-constrained). Zero targets are normalized away on write
 * (0 == absent, documented). Portfolio deletion cascades.
 */
model PortfolioAllocationStrategyTarget {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  category    String   @db.VarChar(50)
  targetBp    Int      @map("target_bp")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, category])
  @@index([portfolioId])
  @@map("portfolio_allocation_strategy_targets")
}

/// Phase 5Q-F — user-declared contribution plans (future intent, not advice).
///
/// `portfolio_contribution_plans` stores what the user intends to contribute
/// (name + date-only `planned_date` + status); `portfolio_contribution_plan_items`
/// stores the manually-declared per-category amounts as exact Decimals.
/// Status machine: PLANNED → COMPLETED | CANCELLED (terminal, no reopen in
/// v1). COMPLETED/CANCELLED never create transactions, orders or ledger
/// writes — marking complete only flips status (+ completed_at).
/// `source_scenario_id` is optional provenance (SET NULL on scenario
/// delete); plans never depend on the scenario afterwards. No projected
/// values, deviations, coverage, scores or recommendations are persisted:
/// live impact is always recomputed. Portfolio deletion cascades.
model PortfolioContributionPlan {
  id               String    @id @default(uuid()) @db.Uuid
  portfolioId      String    @map("portfolio_id") @db.Uuid
  name             String    @db.VarChar(80)
  plannedDate      DateTime  @map("planned_date") @db.Date
  status           String    @default("PLANNED") @db.VarChar(20)
  currency         String    @db.VarChar(3)
  sourceScenarioId String?   @map("source_scenario_id") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio      Portfolio                    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  sourceScenario PortfolioAllocationScenario? @relation(fields: [sourceScenarioId], references: [id], onDelete: SetNull)
  items          PortfolioContributionPlanItem[]
  trackingLinks  ContributionPlanTransactionLink[]

  @@index([portfolioId])
  @@index([portfolioId, status, plannedDate])
  @@map("portfolio_contribution_plans")
}

model PortfolioContributionPlanItem {
  id       String   @id @default(uuid()) @db.Uuid
  planId   String   @map("plan_id") @db.Uuid
  category String   @db.VarChar(50)
  amount   Decimal  @db.Decimal(38, 18)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan PortfolioContributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, category])
  @@index([planId])
  @@map("portfolio_contribution_plan_items")
}

/// Phase 5Q-G — links between contribution plans and ledger transactions.
///
/// One row per (plan, transaction): CONFIRMED (user-confirmed actual) or
/// REJECTED (user-dismissed candidate; memory so it never reappears).
/// Candidates are derived on read and never persisted. No amounts, dates,
/// categories, assets or currencies are stored here — those facts always
/// come from the ledger (Transaction) and the plan (items). A partial
/// unique index guarantees one CONFIRMED plan per transaction (no
/// double-counted actuals across plans; v1 does not split transactions).
/// Plan delete cascades (PLANNED plans are the only deletable ones;
/// terminal history is immutable upstream). Transaction delete cascades as
/// well: links are portfolio-scoped rows and portfolio deletion already
/// cascades every other relation; the ledger itself stays append-only via
/// the API (no transaction delete path exists).
model ContributionPlanTransactionLink {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  transactionId String    @map("transaction_id") @db.Uuid
  status        String    @db.VarChar(20)
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedAt    DateTime? @map("rejected_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan        PortfolioContributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  transaction Transaction                 @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([planId, transactionId])
  @@index([planId])
  @@index([planId, status])
  @@map("contribution_plan_transaction_links")
}

/// Phase 5Q-J — user-defined monthly contribution goals (versioned intent).
///
/// One row per effective version: [effectiveFromMonth, effectiveToMonth)
/// with NULL end meaning open-ended. Only one open version per portfolio
/// (partial unique index); closing + creating happens atomically in the
/// repository. Past months are never rewritten: edits close the open
/// version at the chosen month and open a new one. No targets, no scores,
/// no forecasts, no recommendations — just the user's declared number.
model PortfolioContributionGoal {
  id               String    @id @default(uuid()) @db.Uuid
  portfolioId      String    @map("portfolio_id") @db.Uuid
  amount           Decimal   @db.Decimal(38, 18)
  currency         String    @db.VarChar(3)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([portfolioId, effectiveFrom])
  @@map("portfolio_contribution_goals")
}

/// Phase 5Q-E — saved hypothetical allocation scenarios (input only).
///
/// `portfolio_allocation_scenarios` stores the user's declared hypothesis
/// (name + type); `portfolio_allocation_scenario_changes` stores the
/// manually-split hypothetical contribution per asset class as exact
/// Decimal amounts (canonical form, ≤2 decimals, > 0 enforced by CHECK).
/// Duplicate names are allowed (identity is the id). No projected values,
/// weights, deviations, coverage or recommendations are ever persisted:
/// results are always recomputed live against the current portfolio and
/// strategy. Portfolio/scenario deletion cascades.
model PortfolioAllocationScenario {
  id          String   @id @default(uuid()) @db.Uuid
  portfolioId String   @map("portfolio_id") @db.Uuid
  name        String   @db.VarChar(80)
  type        String   @default("CONTRIBUTION") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio                           @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  changes   PortfolioAllocationScenarioChange[]
  sourcedPlans PortfolioContributionPlan[]

  @@index([portfolioId])
  @@map("portfolio_allocation_scenarios")
}

model PortfolioAllocationScenarioChange {
  id         String   @id @default(uuid()) @db.Uuid
  scenarioId String   @map("scenario_id") @db.Uuid
  category   String   @db.VarChar(50)
  amount     Decimal  @db.Decimal(38, 18)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scenario PortfolioAllocationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, category])
  @@index([scenarioId])
  @@map("portfolio_allocation_scenario_changes")
}

model AiConversation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  title       String?   @db.VarChar(255)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio               @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  messages  AiConversationMessage[]

  @@index([userId])
  @@index([portfolioId])
  @@index([portfolioId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  role              String   @db.VarChar(20)
  content           String   @db.Text
  status            String   @default("ANSWERED") @db.VarChar(50)
  intent            String?  @db.VarChar(100)
  evidenceSnapshot  Json?    @map("evidence_snapshot") @db.JsonB
  claims            Json?    @map("claims") @db.JsonB
  limitations       String[] @default([]) @map("limitations")
  provider          String?  @db.VarChar(100)
  model             String?  @db.VarChar(100)
  providerRequestId String?  @map("provider_request_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("ai_conversation_messages")
}

model MarketIntelligenceItem {
  id             String   @id @default(uuid()) @db.Uuid
  sourceProvider String   @map("source_provider") @db.VarChar(100)
  sourceType     String   @map("source_type") @db.VarChar(50)
  sourceItemId   String   @map("source_item_id") @db.VarChar(255)
  headline       String   @db.VarChar(500)
  excerpt        String?  @db.VarChar(2000)
  canonicalUrl   String?  @map("canonical_url") @db.VarChar(1000)
  publishedAt    DateTime @map("published_at") @db.Timestamptz(6)
  retrievedAt    DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  category       String   @db.VarChar(50)
  language       String   @default("pt-BR") @db.VarChar(10)
  status         String   @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assetLinks MarketIntelligenceAssetLink[]

  @@unique([sourceProvider, sourceItemId], name: "source_provider_item_id_unique")
  @@index([publishedAt])
  @@index([category])
  @@map("market_intelligence_items")
}

model MarketIntelligenceAssetLink {
  id                       String   @id @default(uuid()) @db.Uuid
  marketIntelligenceItemId String   @map("market_intelligence_item_id") @db.Uuid
  assetId                  String   @map("asset_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item  MarketIntelligenceItem @relation(fields: [marketIntelligenceItemId], references: [id], onDelete: Cascade)
  asset Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([marketIntelligenceItemId, assetId], name: "item_asset_link_unique")
  @@index([assetId])
  @@index([marketIntelligenceItemId])
  @@map("market_intelligence_asset_links")
}

/// Phase 4B.3 — persisted canonical trade classification (auxiliary tax input).
/// References the immutable transaction; never mutates it.
model TaxTradeClassificationRecord {
  id              String    @id @default(uuid()) @db.Uuid
  taxSubjectId    String    @map("tax_subject_id") @db.Uuid
  transactionId   String    @map("transaction_id") @db.Uuid
  classification  String    @db.VarChar(20)
  sourceType      String    @map("source_type") @db.VarChar(50)
  sourceReference String    @map("source_reference") @db.VarChar(255)
  effectiveDate   DateTime  @map("effective_date") @db.Date
  status          String    @db.VarChar(20)
  conflictStatus  String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint     String    @db.VarChar(64)
  provenance      Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject  User        @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, transactionId, sourceReference], name: "tax_trade_classification_identity")
  @@index([taxSubjectId, transactionId])
  @@index([taxSubjectId, effectiveDate])
  @@map("tax_trade_classification_records")
}

/// Phase 4B.3 — persisted canonical withholding/IRRF input (exact decimal).
model TaxWithholdingInputRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  competence          String    @db.Char(7)
  economicDate        DateTime  @map("economic_date") @db.Date
  category            String    @db.VarChar(50)
  withholdingCategory String?   @map("withholding_category") @db.VarChar(30)
  amount              Decimal?  @db.Decimal(38, 18)
  currency            String    @db.VarChar(3)
  status              String    @db.VarChar(20)
  sourceType          String    @map("source_type") @db.VarChar(50)
  sourceReference     String    @map("source_reference") @db.VarChar(255)
  conflictStatus      String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint         String    @db.VarChar(64)
  provenance          Json
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, sourceType, sourceReference], name: "tax_withholding_identity")
  @@index([taxSubjectId, competence])
  @@index([taxSubjectId, economicDate])
  @@map("tax_withholding_input_records")
}

/// Phase 4B.3 — persisted FII tax-condition metadata (factual input only).
/// User-attested facts scoped to the tax subject; never tax treatment.
model FiiTaxEligibilityFactRecord {
  id                       String   @id @default(uuid()) @db.Uuid
  taxSubjectId             String   @map("tax_subject_id") @db.Uuid
  assetId                  String   @map("asset_id") @db.Uuid
  asOfDate                 DateTime @map("as_of_date") @db.Date
  holderCount              Int?     @map("holder_count")
  investorOwnershipPercent Decimal? @map("investor_ownership_percent") @db.Decimal(38, 18)
  isExchangeTraded         Boolean? @map("is_exchange_traded")
  sourceType               String   @map("source_type") @db.VarChar(50)
  sourceReference          String   @map("source_reference") @db.VarChar(255)
  status                   String   @db.VarChar(20)
  conflictStatus           String   @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint              String   @db.VarChar(64)
  provenance               Json
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User  @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, assetId, sourceType, sourceReference, asOfDate], name: "fii_tax_eligibility_identity")
  @@index([taxSubjectId, assetId, asOfDate])
  @@map("fii_tax_eligibility_fact_records")
}

/// Phase 4C.2 — official federal tax deadline registry (direct authority).
/// Reference data seeded from the official RFB Agenda Tributária / ADE CORAT.
/// Immutable/versioned: a Receita correction creates a new version and marks the
/// previous one SUPERSEDED (ADR-262, ADR-263). At most one active VERIFIED entry
/// per (revenue_code, competence) is enforced by a partial unique index in the
/// migration.
model FederalTaxDeadlineEntry {
  id                String   @id @default(uuid()) @db.Uuid
  revenueCode       String   @map("revenue_code") @db.VarChar(10)
  taxBucket         String   @map("tax_bucket") @db.VarChar(30)
  competence        String   @db.Char(7)
  dueDate           DateTime @map("due_date") @db.Date
  status            String   @db.VarChar(20)
  sourceAuthority   String   @map("source_authority") @db.VarChar(100)
  sourceDocument    String   @map("source_document") @db.VarChar(200)
  sourceReference   String   @map("source_reference") @db.VarChar(500)
  sourcePublishedAt DateTime @map("source_published_at") @db.Date
  verifiedAt        DateTime @map("verified_at") @db.Date
  version           Int
  supersedesEntryId String?  @map("supersedes_entry_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  obligations TaxObligationRecord[]

  @@unique([revenueCode, competence, version], name: "federal_tax_deadline_version_identity")
  @@index([revenueCode, competence, status])
  @@map("federal_tax_deadline_entries")
}

/// Phase 4C.2 — derived operational tax obligation. Never recalculates tax.
/// Materialized from a canonical MonthlyTaxLiability + a verified deadline entry
/// (ADR-264). Immutable per revision; liability changes supersede the previous
/// revision (ADR-267).
model TaxObligationRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  taxSubjectId         String    @map("tax_subject_id") @db.Uuid
  competence           String    @db.Char(7)
  taxBucket            String?   @map("tax_bucket") @db.VarChar(30)
  revenueCode          String?   @map("revenue_code") @db.VarChar(10)
  liabilityFingerprint String    @map("liability_fingerprint") @db.VarChar(64)
  revision             Int
  deadlineEntryId      String?   @map("deadline_entry_id") @db.Uuid
  principalAmount      Decimal?  @map("principal_amount") @db.Decimal(38, 18)
  currency             String?   @db.VarChar(3)
  dueDate              DateTime? @map("due_date") @db.Date
  status               String    @db.VarChar(30)
  reasonCode           String?   @map("reason_code") @db.VarChar(50)
  darfReadiness        String    @map("darf_readiness") @db.VarChar(20)
  darfReadinessReason  String?   @map("darf_readiness_reason") @db.VarChar(50)
  dataQuality          String    @map("data_quality") @db.VarChar(20)
  supersededById       String?   @map("superseded_by_id") @db.Uuid
  provenance           Json
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject            User                           @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  deadlineEntry         FederalTaxDeadlineEntry?       @relation(fields: [deadlineEntryId], references: [id])
  payments              TaxPaymentEvidenceRecord[]
  carryForwardSources   TaxCarryForwardEntry[]         @relation("CarryForwardSource")
  paymentAggregations   TaxPaymentAggregation[]        @relation("AggregationCurrentObligation")
  darfGenerationRecords OfficialDarfGenerationRecord[] @relation("DarfGenerationObligation")

  @@unique([taxSubjectId, competence, liabilityFingerprint, revision], name: "tax_obligation_identity")
  @@index([taxSubjectId, competence])
  @@index([taxSubjectId, status])
  @@map("tax_obligations")
}

/// Phase 4C.2 — manual payment evidence (operational only). Never mutates the
/// tax liability (ADR-266). `MANUAL_CONFIRMED` is the only supported source.
model TaxPaymentEvidenceRecord {
  id              String   @id @default(uuid()) @db.Uuid
  obligationId    String   @map("obligation_id") @db.Uuid
  taxSubjectId    String   @map("tax_subject_id") @db.Uuid
  paidAt          DateTime @map("paid_at") @db.Date
  amount          Decimal  @db.Decimal(38, 18)
  currency        String   @db.VarChar(3)
  sourceType      String   @map("source_type") @db.VarChar(30)
  sourceReference String?  @map("source_reference") @db.VarChar(255)
  confirmedAt     DateTime @map("confirmed_at") @db.Timestamptz(6)
  status          String   @db.VarChar(20)
  fingerprint     String   @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  obligation TaxObligationRecord @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  taxSubject User                @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([obligationId, sourceReference], name: "tax_payment_evidence_source_identity")
  @@unique([obligationId, fingerprint], name: "tax_payment_evidence_fingerprint_identity")
  @@index([taxSubjectId, obligationId])
  @@map("tax_payment_evidence")
}

/// Phase 4D.2 — immutable official Sicalc late-fee snapshots. Authoritative for
/// the business-day-sensitive late-fee amount/percent (no generic holiday
/// calendar). Corrections create a new version (ADR-271).
model OfficialLateFeeSnapshot {
  id                String    @id @default(uuid()) @db.Uuid
  municipalityCode  String    @map("municipality_code") @db.VarChar(10)
  dueDate           DateTime  @map("due_date") @db.Date
  paymentDate       DateTime  @map("payment_date") @db.Date
  principalAmount   Decimal   @map("principal_amount") @db.Decimal(38, 18)
  lateFeeAmount     Decimal   @map("late_fee_amount") @db.Decimal(38, 18)
  lateFeePercent    Decimal   @map("late_fee_percent") @db.Decimal(38, 18)
  startBusinessDate DateTime? @map("start_business_date") @db.Date
  sourceSystem      String    @map("source_system") @db.VarChar(30)
  sourceReference   String    @map("source_reference") @db.VarChar(500)
  sourceRetrievedAt DateTime  @map("source_retrieved_at") @db.Timestamptz(6)
  verifiedAt        DateTime  @map("verified_at") @db.Timestamptz(6)
  version           Int
  fingerprint       String    @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([municipalityCode, dueDate, paymentDate, principalAmount, version], name: "official_late_fee_snapshot_identity")
  @@index([municipalityCode, dueDate, paymentDate])
  @@map("official_late_fee_snapshots")
}

/// Phase 4D.2 — immutable official monthly SELIC rate snapshots. Source: RFB
/// Sicalc/RFB acts only; missing rate fails closed (ADR-272).
model TaxInterestRateSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  indexName         String   @map("index_name") @db.VarChar(30)
  referenceMonth    String   @map("reference_month") @db.Char(7)
  ratePercent       Decimal  @map("rate_percent") @db.Decimal(38, 18)
  sourceAuthority   String   @map("source_authority") @db.VarChar(100)
  sourceReference   String   @map("source_reference") @db.VarChar(500)
  sourceRetrievedAt DateTime @map("source_retrieved_at") @db.Timestamptz(6)
  verifiedAt        DateTime @map("verified_at") @db.Timestamptz(6)
  version           Int
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([indexName, referenceMonth, version], name: "tax_interest_rate_snapshot_identity")
  @@index([indexName, referenceMonth])
  @@map("tax_interest_rate_snapshots")
}

/// Phase 4E - deferred sub-minimum federal tax amounts (immutable facts).
/// A below-minimum obligation produces an `OPEN` entry; it is consumed exactly
/// once when the accumulated same-revenue-code total reaches the minimum
/// (ADR-279, ADR-281). Corrections supersede the entry, never rewrite history.
model TaxCarryForwardEntry {
  id                      String    @id @default(uuid()) @db.Uuid
  taxSubjectId            String    @map("tax_subject_id") @db.Uuid
  sourceObligationId      String    @map("source_obligation_id") @db.Uuid
  sourceCompetence        String    @map("source_competence") @db.Char(7)
  revenueCode             String    @map("revenue_code") @db.VarChar(10)
  currency                String    @db.VarChar(3)
  amount                  Decimal   @db.Decimal(38, 18)
  status                  String    @db.VarChar(20)
  targetCompetence        String?   @map("target_competence") @db.Char(7)
  consumedByAggregationId String?   @map("consumed_by_aggregation_id") @db.Uuid
  consumedAt              DateTime? @map("consumed_at") @db.Timestamptz(6)
  ruleId                  String    @map("rule_id") @db.VarChar(100)
  ruleVersion             String    @map("rule_version") @db.VarChar(30)
  fingerprint             String    @db.VarChar(64)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject            User                   @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  sourceObligation      TaxObligationRecord    @relation("CarryForwardSource", fields: [sourceObligationId], references: [id], onDelete: Cascade)
  consumedByAggregation TaxPaymentAggregation? @relation("AggregationConsumedEntries", fields: [consumedByAggregationId], references: [id])

  @@unique([sourceObligationId, ruleId, ruleVersion], name: "tax_carry_forward_source_identity")
  @@index([taxSubjectId, revenueCode, status])
  @@index([taxSubjectId, revenueCode, targetCompetence])
  @@map("tax_carry_forward_entries")
}

/// Phase 4E - derived payment aggregation unit (current competence + open
/// same-code carry-forward). Never recalculates tax (ADR-279, ADR-280).
model TaxPaymentAggregation {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  revenueCode         String    @map("revenue_code") @db.VarChar(10)
  targetCompetence    String    @map("target_competence") @db.Char(7)
  currency            String    @db.VarChar(3)
  currentAmount       Decimal   @map("current_amount") @db.Decimal(38, 18)
  carryForwardAmount  Decimal   @map("carry_forward_amount") @db.Decimal(38, 18)
  totalPayable        Decimal   @map("total_payable") @db.Decimal(38, 18)
  minimumThreshold    Decimal   @map("minimum_threshold") @db.Decimal(38, 18)
  sourceEntryIds      Json      @map("source_entry_ids")
  currentObligationId String?   @map("current_obligation_id") @db.Uuid
  dueDate             DateTime? @map("due_date") @db.Date
  status              String    @db.VarChar(20)
  ruleId              String    @map("rule_id") @db.VarChar(100)
  ruleVersion         String    @map("rule_version") @db.VarChar(30)
  fingerprint         String    @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject        User                   @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  currentObligation TaxObligationRecord?   @relation("AggregationCurrentObligation", fields: [currentObligationId], references: [id])
  consumedEntries   TaxCarryForwardEntry[] @relation("AggregationConsumedEntries")

  @@unique([taxSubjectId, revenueCode, targetCompetence, fingerprint], name: "tax_payment_aggregation_identity")
  @@index([taxSubjectId, revenueCode, targetCompetence])
  @@map("tax_payment_aggregations")
}

/// Phase 4F - taxpayer identity boundary. Stores ONLY a masked display form and
/// an opaque HMAC reference; the raw CPF/CNPJ is never persisted (ADR-286).
model TaxpayerIdentityRecord {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  identityType      String   @map("identity_type") @db.VarChar(10)
  maskedIdentifier  String   @map("masked_identifier") @db.VarChar(30)
  secureReference   String   @map("secure_reference") @db.VarChar(64)
  identityAvailable Boolean  @map("identity_available")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taxpayer_identities")
}

/// Phase 4F - immutable official DARF generation/handoff record. Atlas does not
/// generate the official document; the record captures the prepared handoff and
/// its provenance. GENERATED is never equivalent to PAID (ADR-287, ADR-288).
model OfficialDarfGenerationRecord {
  id                      String    @id @default(uuid()) @db.Uuid
  taxSubjectId            String    @map("tax_subject_id") @db.Uuid
  taxObligationId         String?   @map("tax_obligation_id") @db.Uuid
  taxPaymentAggregationId String?   @map("tax_payment_aggregation_id") @db.Uuid
  generationMode          String    @map("generation_mode") @db.VarChar(40)
  revenueCode             String    @map("revenue_code") @db.VarChar(10)
  competence              String    @db.Char(7)
  dueDate                 DateTime? @map("due_date") @db.Date
  principalAmount         Decimal   @map("principal_amount") @db.Decimal(38, 18)
  lateFeeAmount           Decimal?  @map("late_fee_amount") @db.Decimal(38, 18)
  interestAmount          Decimal?  @map("interest_amount") @db.Decimal(38, 18)
  totalAmount             Decimal   @map("total_amount") @db.Decimal(38, 18)
  currency                String    @db.VarChar(3)
  officialDocumentId      String?   @map("official_document_id") @db.VarChar(100)
  officialReference       String?   @map("official_reference") @db.VarChar(255)
  sourceSystem            String    @map("source_system") @db.VarChar(40)
  status                  String    @db.VarChar(30)
  version                 Int
  fingerprint             String    @db.VarChar(64)
  supersededById          String?   @map("superseded_by_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject    User                 @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  taxObligation TaxObligationRecord? @relation("DarfGenerationObligation", fields: [taxObligationId], references: [id])

  @@unique([taxSubjectId, taxObligationId, fingerprint], name: "official_darf_generation_identity")
  @@index([taxSubjectId, status])
  @@index([taxSubjectId, taxObligationId])
  @@map("official_darf_generation_records")
}

/// Phase 4G.2A.1a - persisted, immutable tax-compensation election revisions.
/// One logical election identity is `(taxSubjectId, competence, electionType)`;
/// each change inserts a new monotonic `version` (never an in-place update).
/// Same value is idempotent. Source is `MANUAL_CONFIRMED` only.
model TaxCompensationElectionRecord {
  id           String   @id @default(uuid()) @db.Uuid
  taxSubjectId String   @map("tax_subject_id") @db.Uuid
  competence   String   @db.Char(7)
  electionType String   @map("election_type") @db.VarChar(60)
  value        String   @db.VarChar(30)
  version      Int
  source       String   @db.VarChar(30)
  supersedesId String?  @map("supersedes_id") @db.Uuid
  fingerprint  String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, competence, electionType, version], name: "tax_compensation_election_revision_identity")
  @@index([taxSubjectId, competence, electionType])
  @@map("tax_compensation_elections")
}

/// Phase 4H.2 - canonical opening position input record for pre-Atlas holdings.
/// One logical identity is `(taxSubjectId, portfolioId, accountId, assetId, revision)`.
/// Superseded records maintain full audit history.
model AnnualOpeningPositionInputRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  portfolioId         String    @map("portfolio_id") @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  assetId             String    @map("asset_id") @db.Uuid
  effectiveDate       DateTime  @map("effective_date") @db.Date
  quantity            Decimal   @db.Decimal(38, 18)
  totalHistoricalCost Decimal   @map("total_historical_cost") @db.Decimal(38, 18)
  currency            String    @db.VarChar(3)
  source              String    @db.VarChar(40)
  status              String    @db.VarChar(30)
  revision            Int
  fingerprint         String    @db.VarChar(64)
  notes               String?   @db.Text
  supersedesId        String?   @map("supersedes_id") @db.Uuid
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User      @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  portfolio  Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([taxSubjectId, portfolioId, accountId, assetId, revision], name: "annual_opening_position_revision_identity", map: "annual_opening_pos_rev_uniq")
  @@index([taxSubjectId, portfolioId, accountId, assetId, status], map: "annual_opening_pos_lookup_idx")
  @@index([taxSubjectId, status], map: "annual_opening_pos_subj_status_idx")
  @@map("annual_opening_position_inputs")
}

/// Phase 4H.5 - persisted, audited taxpayer confirmations for annual tax readiness.
/// Captures taxpayer declarations (e.g. FII eligibility, dividend transition, opening positions, withholding).
/// Monotonic revision increments on updates; stale confirmations are detected if sourceFingerprint changes.
model TaxpayerConfirmationRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  taxSubjectId       String   @map("tax_subject_id") @db.Uuid
  calendarYear       Int      @map("calendar_year")
  confirmationType   String   @map("confirmation_type") @db.VarChar(60)
  subjectReference   String   @map("subject_reference") @db.VarChar(255)
  decision           String   @db.VarChar(30)
  statementVersion   String   @map("statement_version") @db.VarChar(30)
  sourceFingerprint  String   @map("source_fingerprint") @db.VarChar(64)
  source             String   @db.VarChar(50)
  createdByPrincipal String   @map("created_by_principal") @db.VarChar(255)
  revision           Int
  fingerprint        String   @db.VarChar(64)
  supersedesId       String?  @map("supersedes_id") @db.Uuid
  notes              String?  @db.Text
  confirmedAt        DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, calendarYear, confirmationType, subjectReference, revision], name: "taxpayer_confirmation_revision_identity", map: "taxpayer_conf_rev_uniq")
  @@index([taxSubjectId, calendarYear, confirmationType, subjectReference], map: "taxpayer_conf_lookup_idx")
  @@index([taxSubjectId, calendarYear], map: "taxpayer_conf_year_idx")
  @@map("taxpayer_confirmations")
}

/// Phase 4I.4 - persisted high-income annual evidence (corporate effective-tax facts,
/// annual adjustment attestations, attested annual-income totals).
/// Only non-derivable evidence facts are stored; every calculation remains derived.
/// Monotonic revision increments; conflicting candidates fail closed until resolved.
model HighIncomeEvidenceRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  taxSubjectId         String   @map("tax_subject_id") @db.Uuid
  calendarYear         Int      @map("calendar_year")
  payerKey             String   @map("payer_key") @db.VarChar(255)
  payerId              String?  @map("payer_id") @db.VarChar(255)
  evidenceType         String   @map("evidence_type") @db.VarChar(40)
  payerType            String?  @map("payer_type") @db.VarChar(40)
  profitPeriodExercise Int?     @map("profit_period_exercise")
  evidenceMode         String?  @map("evidence_mode") @db.VarChar(20)
  accountingProfit     Decimal? @map("accounting_profit") @db.Decimal(38, 18)
  irDue                Decimal? @map("ir_due") @db.Decimal(38, 18)
  csllDue              Decimal? @map("csll_due") @db.Decimal(38, 18)
  prouniTaxCredit      Decimal? @map("prouni_tax_credit") @db.Decimal(38, 18)
  simplifiedRevenue    Decimal? @map("simplified_revenue") @db.Decimal(38, 18)
  adjustmentAmount     Decimal? @map("adjustment_amount") @db.Decimal(38, 18)
  authority            String   @db.VarChar(30)
  evidenceSource       String   @map("evidence_source") @db.VarChar(40)
  conflictStatus       String   @default("NONE") @map("conflict_status") @db.VarChar(20)
  upstreamFingerprint  String?  @map("upstream_fingerprint") @db.VarChar(64)
  sourceFingerprint    String   @map("source_fingerprint") @db.VarChar(64)
  revision             Int
  fingerprint          String   @db.VarChar(64)
  supersedesId         String?  @map("supersedes_id") @db.Uuid
  resolutionNote       String?  @map("resolution_note") @db.VarChar(40)
  createdByPrincipal   String   @map("created_by_principal") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, calendarYear, payerKey, evidenceType, profitPeriodExercise, revision], name: "high_income_evidence_revision_identity", map: "hi_evidence_rev_uniq")
  @@index([taxSubjectId, calendarYear, evidenceType, payerKey], map: "hi_evidence_lookup_idx")
  @@index([taxSubjectId, calendarYear], map: "hi_evidence_year_idx")
  @@map("high_income_evidence_records")
}

/// Phase 4K.1 - persisted, audited taxpayer compliance workflow actions.
/// Captures user-reported actions (e.g. completion, dismissal, acknowledgment)
/// for operational compliance obligations without mutating tax calculations.
/// Monotonic revision increments on updates; stale actions are detected if sourceFingerprint changes.
model TaxComplianceActionRecord {
  id                String   @id @default(uuid()) @db.Uuid
  taxSubjectId      String   @map("tax_subject_id") @db.Uuid
  obligationKey     String   @map("obligation_key") @db.VarChar(255)
  actionType        String   @map("action_type") @db.VarChar(50)
  sourceFingerprint String?  @map("source_fingerprint") @db.VarChar(64)
  note              String?  @db.Text
  metadata          Json?
  revision          Int      @default(1)
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, obligationKey, revision], name: "tax_compliance_action_revision_identity", map: "tax_compliance_action_rev_uniq")
  @@index([taxSubjectId, obligationKey], map: "tax_compliance_action_lookup_idx")
  @@index([taxSubjectId, occurredAt], map: "tax_compliance_action_time_idx")
  @@map("tax_compliance_actions")
}

/// Phase 4K.2 — user-reported external payment evidence / settlement record.
/// Immutable per revision; stale if underlying obligation sourceFingerprint changes (ADR-286).
model TaxSettlementRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  taxSubjectId        String   @map("tax_subject_id") @db.Uuid
  obligationKey       String   @map("obligation_key") @db.VarChar(255)
  sourceFingerprint   String   @map("source_fingerprint") @db.VarChar(64)
  evidenceFingerprint String   @map("evidence_fingerprint") @db.VarChar(64)
  revision            Int      @default(1)
  paymentDate         DateTime @map("payment_date") @db.Date
  amountReported      Decimal  @map("amount_reported") @db.Decimal(38, 18)
  revenueCodeReported String?  @map("revenue_code_reported") @db.VarChar(16)
  referencePeriod     String   @map("reference_period") @db.VarChar(16)
  externalReference   String?  @map("external_reference") @db.VarChar(255)
  note                String?  @db.Text
  verificationStatus  String   @default("USER_REPORTED") @map("verification_status") @db.VarChar(32)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, obligationKey, revision], name: "tax_settlement_record_revision_identity", map: "tax_settlement_record_rev_uniq")
  @@unique([taxSubjectId, obligationKey, sourceFingerprint, evidenceFingerprint], name: "tax_settlement_record_semantic_identity", map: "tax_settlement_record_semantic_uniq")
  @@index([taxSubjectId, obligationKey], map: "tax_settlement_record_lookup_idx")
  @@index([taxSubjectId, referencePeriod], map: "tax_settlement_record_period_idx")
  @@map("tax_settlement_records")
}

/// Phase 4K.3 — user interactions with derived compliance reminders.
/// Append-only per (reminderKey, revision); actions bind to the
/// sourceFingerprint current at interaction time and are never reused
/// across a changed source. Snooze shifts surfacing only, never fiscal state.
model TaxComplianceReminderActionRecord {
  id                String    @id @default(uuid()) @db.Uuid
  taxSubjectId      String    @map("tax_subject_id") @db.Uuid
  reminderKey       String    @map("reminder_key") @db.VarChar(255)
  obligationKey     String    @map("obligation_key") @db.VarChar(255)
  reminderKind      String    @map("reminder_kind") @db.VarChar(50)
  triggerAt         DateTime  @map("trigger_at") @db.Date
  sourceFingerprint String    @map("source_fingerprint") @db.VarChar(64)
  actionType        String    @map("action_type") @db.VarChar(20)
  snoozedUntil      DateTime? @map("snoozed_until") @db.Date
  revision          Int       @default(1)
  occurredAt        DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, reminderKey, revision], name: "tax_compliance_reminder_action_revision_identity", map: "tax_compliance_reminder_action_rev_uniq")
  @@index([taxSubjectId, reminderKey], map: "tax_compliance_reminder_action_lookup_idx")
  @@index([taxSubjectId, occurredAt], map: "tax_compliance_reminder_action_time_idx")
  @@map("tax_compliance_reminder_actions")
}

/// Phase 4K.3 — in-app notification delivery events.
/// One canonical event per (taxSubjectId, dedupKey); retries are idempotent.
model TaxComplianceNotificationEventRecord {
  id                String   @id @default(uuid()) @db.Uuid
  taxSubjectId      String   @map("tax_subject_id") @db.Uuid
  reminderKey       String   @map("reminder_key") @db.VarChar(255)
  sourceFingerprint String   @map("source_fingerprint") @db.VarChar(64)
  channel           String   @map("channel") @db.VarChar(20)
  triggerAt         DateTime @map("trigger_at") @db.Date
  deliveredAt       DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)
  deliveryStatus    String   @default("DELIVERED") @map("delivery_status") @db.VarChar(30)
  attempt           Int      @default(1)
  dedupKey          String   @map("dedup_key") @db.VarChar(512)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, dedupKey], name: "tax_compliance_notification_event_dedup_identity", map: "tax_compliance_notification_event_dedup_uniq")
  @@index([taxSubjectId, reminderKey], map: "tax_compliance_notification_event_lookup_idx")
  @@map("tax_compliance_notification_events")
}

/// Phase 4K.3 — per-subject reminder preferences (product UX policy, not tax law).
/// Single mutable settings row per subject; upserted, never part of fiscal truth.
model TaxComplianceReminderPreferenceRecord {
  taxSubjectId     String   @id @map("tax_subject_id") @db.Uuid
  remindersEnabled Boolean  @default(true) @map("reminders_enabled")
  upcomingEnabled  Boolean  @default(true) @map("upcoming_enabled")
  overdueEnabled   Boolean  @default(true) @map("overdue_enabled")
  annualEnabled    Boolean  @default(true) @map("annual_enabled")
  leadTimes        Int[]    @default([7, 3, 1]) @map("lead_times")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@map("tax_compliance_reminder_preferences")
}

/// Phase 4K.5 — operational period close history (support snapshots only).
/// Append-only per (scope, period, revision). CLOSED rows freeze the
/// semantic fingerprints current at close time; REOPENED rows supersede the
/// current state without deleting history. Fiscal truth stays upstream.
model TaxCompliancePeriodCloseRecord {
  id                String    @id @default(uuid()) @db.Uuid
  taxSubjectId      String    @map("tax_subject_id") @db.Uuid
  scope             String    @db.VarChar(16)
  period            String    @db.VarChar(16)
  calendarYear      Int       @map("calendar_year")
  month             String?   @db.VarChar(7)
  exercise          Int?
  revision          Int       @default(1)
  recordStatus      String    @map("record_status") @db.VarChar(16)
  statusAtClose     String?   @map("status_at_close") @db.VarChar(32)
  closeMode         String?   @map("close_mode") @db.VarChar(32)
  sourceFingerprint String    @map("source_fingerprint") @db.VarChar(64)
  binderFingerprint String    @map("binder_fingerprint") @db.VarChar(64)
  reason            String?   @db.Text
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, scope, period, revision], name: "tax_period_close_revision_identity", map: "tax_period_close_rev_uniq")
  @@index([taxSubjectId, scope, period], map: "tax_period_close_lookup_idx")
  @@map("tax_compliance_period_close_records")
}

/// Phase 5A — Canonical End-of-Day (EOD) Market Quotes.
/// Persistent daily market pricing for custody valuation and performance.
/// Identity is strictly (asset_id, trading_date, provider). Zero floats.
model MarketQuoteRecord {
  id             String    @id @default(uuid()) @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  tradingDate    DateTime  @map("trading_date") @db.Date
  currency       String    @db.VarChar(3)
  open           Decimal?  @db.Decimal(38, 18)
  high           Decimal?  @db.Decimal(38, 18)
  low            Decimal?  @db.Decimal(38, 18)
  close          Decimal   @db.Decimal(38, 18)
  adjustedClose  Decimal?  @map("adjusted_close") @db.Decimal(38, 18)
  volume         Decimal?  @db.Decimal(38, 18)
  provider       String    @db.VarChar(32)
  providerSymbol String    @map("provider_symbol") @db.VarChar(64)
  firstFetchedAt DateTime  @default(now()) @map("first_fetched_at") @db.Timestamptz(6)
  lastFetchedAt  DateTime  @default(now()) @map("last_fetched_at") @db.Timestamptz(6)
  fetchCount     Int       @default(1) @map("fetch_count")
  revisedAt      DateTime? @map("revised_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  asset     Asset                       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  revisions MarketQuoteRevisionRecord[]

  @@unique([assetId, tradingDate, provider], map: "market_quotes_asset_date_provider_uniq")
  @@index([assetId, tradingDate], map: "market_quotes_asset_date_idx")
  @@index([tradingDate], map: "market_quotes_date_idx")
  @@index([provider], map: "market_quotes_provider_idx")
  @@map("market_quotes")
}

/// Phase 5A — Market Quote Revision Audit Trail.
/// Immutable audit log capturing any upstream republishing or corrections.
model MarketQuoteRevisionRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  marketQuoteId      String   @map("market_quote_id") @db.Uuid
  changedAt          DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  priorOpen          Decimal? @map("prior_open") @db.Decimal(38, 18)
  priorHigh          Decimal? @map("prior_high") @db.Decimal(38, 18)
  priorLow           Decimal? @map("prior_low") @db.Decimal(38, 18)
  priorClose         Decimal  @map("prior_close") @db.Decimal(38, 18)
  priorAdjustedClose Decimal? @map("prior_adjusted_close") @db.Decimal(38, 18)
  priorVolume        Decimal? @map("prior_volume") @db.Decimal(38, 18)
  newOpen            Decimal? @map("new_open") @db.Decimal(38, 18)
  newHigh            Decimal? @map("new_high") @db.Decimal(38, 18)
  newLow             Decimal? @map("new_low") @db.Decimal(38, 18)
  newClose           Decimal  @map("new_close") @db.Decimal(38, 18)
  newAdjustedClose   Decimal? @map("new_adjusted_close") @db.Decimal(38, 18)
  newVolume          Decimal? @map("new_volume") @db.Decimal(38, 18)
  reason             String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  marketQuote MarketQuoteRecord @relation(fields: [marketQuoteId], references: [id], onDelete: Cascade)

  @@index([marketQuoteId], map: "market_quote_revisions_quote_idx")
  @@map("market_quote_revisions")
}

/// Phase 5B — Canonical Benchmark Observation.
/// Preserves explicit semantics, frequency, and unit (Index Points vs Daily Percent vs Monthly Percent).
model BenchmarkObservationRecord {
  id               String    @id @default(uuid()) @db.Uuid
  benchmarkId      String    @map("benchmark_id") @db.VarChar(32)
  referenceDate    DateTime  @map("reference_date") @db.Date
  value            Decimal   @map("value") @db.Decimal(38, 18)
  unit             String    @map("unit") @db.VarChar(32)
  frequency        String    @map("frequency") @db.VarChar(32)
  source           String    @map("source") @db.VarChar(64)
  providerSeriesId String?   @map("provider_series_id") @db.VarChar(64)
  firstFetchedAt   DateTime  @default(now()) @map("first_fetched_at") @db.Timestamptz(6)
  lastFetchedAt    DateTime  @default(now()) @map("last_fetched_at") @db.Timestamptz(6)
  fetchCount       Int       @default(1) @map("fetch_count")
  revisedAt        DateTime? @map("revised_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions BenchmarkObservationRevisionRecord[]

  @@unique([benchmarkId, referenceDate, source], map: "benchmark_observations_benchmark_date_source_uniq")
  @@index([benchmarkId, referenceDate], map: "benchmark_observations_benchmark_date_idx")
  @@index([referenceDate], map: "benchmark_observations_date_idx")
  @@index([source], map: "benchmark_observations_source_idx")
  @@map("benchmark_observations")
}

/// Phase 5B — Benchmark Observation Revision Audit Trail.
/// Immutable audit log capturing any upstream republishing or corrections from official sources.
model BenchmarkObservationRevisionRecord {
  id                     String   @id @default(uuid()) @db.Uuid
  benchmarkObservationId String   @map("benchmark_observation_id") @db.Uuid
  changedAt              DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  priorValue             Decimal  @map("prior_value") @db.Decimal(38, 18)
  newValue               Decimal  @map("new_value") @db.Decimal(38, 18)
  reason                 String?  @db.VarChar(255)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  observation BenchmarkObservationRecord @relation(fields: [benchmarkObservationId], references: [id], onDelete: Cascade)

  @@index([benchmarkObservationId], map: "benchmark_observation_revisions_obs_idx")
  @@map("benchmark_observation_revisions")
}

/// Phase 5C — Canonical Foreign Exchange (FX) Observations.
/// Preserves currency pair exchange rates (baseCurrency, quoteCurrency) with exact decimal precision.
model FxObservationRecord {
  id               String    @id @default(uuid()) @db.Uuid
  baseCurrency     String    @map("base_currency") @db.VarChar(3)
  quoteCurrency    String    @map("quote_currency") @db.VarChar(3)
  observationDate  DateTime  @map("observation_date") @db.Date
  rate             Decimal   @map("rate") @db.Decimal(38, 18)
  rateType         String    @default("MID") @map("rate_type") @db.VarChar(16)
  source           String    @map("source") @db.VarChar(64)
  providerSeriesId String?   @map("provider_series_id") @db.VarChar(64)
  firstFetchedAt   DateTime  @default(now()) @map("first_fetched_at") @db.Timestamptz(6)
  lastFetchedAt    DateTime  @default(now()) @map("last_fetched_at") @db.Timestamptz(6)
  fetchCount       Int       @default(1) @map("fetch_count")
  revisedAt        DateTime? @map("revised_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions FxObservationRevisionRecord[]

  @@unique([baseCurrency, quoteCurrency, observationDate, source, rateType], map: "fx_observations_pair_date_source_type_uniq")
  @@index([baseCurrency, quoteCurrency, observationDate], map: "fx_observations_pair_date_idx")
  @@index([observationDate], map: "fx_observations_date_idx")
  @@index([source], map: "fx_observations_source_idx")
  @@map("fx_observations")
}

/// Phase 5C — FX Observation Revision Audit Trail.
/// Immutable audit log capturing any upstream republishing or corrections from official authorities.
model FxObservationRevisionRecord {
  id              String   @id @default(uuid()) @db.Uuid
  fxObservationId String   @map("fx_observation_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  priorRate       Decimal  @map("prior_rate") @db.Decimal(38, 18)
  newRate         Decimal  @map("new_rate") @db.Decimal(38, 18)
  reason          String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  observation FxObservationRecord @relation(fields: [fxObservationId], references: [id], onDelete: Cascade)

  @@index([fxObservationId], map: "fx_observation_revisions_obs_idx")
  @@map("fx_observation_revisions")
}

/// Phase 5D — Official Calendar Days.
/// Distinguishes open trading/banking sessions from weekends and official holidays.
model CalendarDayRecord {
  id           String   @id @default(uuid()) @db.Uuid
  calendarType String   @map("calendar_type") @db.VarChar(32)
  date         DateTime @map("date") @db.Date
  isOpen       Boolean  @map("is_open")
  reason       String?  @map("reason") @db.VarChar(255)
  source       String   @map("source") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([calendarType, date], map: "calendar_days_type_date_uniq")
  @@index([calendarType, date], map: "calendar_days_type_date_idx")
  @@index([date], map: "calendar_days_date_idx")
  @@map("calendar_days")
}

/// Phase 5D — Canonical Macroeconomic Series Observations.
/// Stores headline macroeconomic series (e.g., IPCA monthly, SELIC Copom target, SELIC effective).
model MacroObservationRecord {
  id             String    @id @default(uuid()) @db.Uuid
  seriesId       String    @map("series_id") @db.VarChar(32)
  referenceDate  DateTime  @map("reference_date") @db.Date
  value          Decimal   @map("value") @db.Decimal(38, 18)
  unit           String    @map("unit") @db.VarChar(32)
  frequency      String    @map("frequency") @db.VarChar(32)
  source         String    @map("source") @db.VarChar(64)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  firstFetchedAt DateTime  @default(now()) @map("first_fetched_at") @db.Timestamptz(6)
  lastFetchedAt  DateTime  @default(now()) @map("last_fetched_at") @db.Timestamptz(6)
  fetchCount     Int       @default(1) @map("fetch_count")
  revisedAt      DateTime? @map("revised_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions MacroObservationRevisionRecord[]

  @@unique([seriesId, referenceDate, source], map: "macro_observations_series_date_source_uniq")
  @@index([seriesId, referenceDate], map: "macro_observations_series_date_idx")
  @@index([referenceDate], map: "macro_observations_date_idx")
  @@index([source], map: "macro_observations_source_idx")
  @@map("macro_observations")
}

/// Phase 5D — Macro Observation Revision Audit Trail.
model MacroObservationRevisionRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  macroObservationId String   @map("macro_observation_id") @db.Uuid
  changedAt          DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  priorValue         Decimal  @map("prior_value") @db.Decimal(38, 18)
  newValue           Decimal  @map("new_value") @db.Decimal(38, 18)
  reason             String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  observation MacroObservationRecord @relation(fields: [macroObservationId], references: [id], onDelete: Cascade)

  @@index([macroObservationId], map: "macro_observation_revisions_obs_idx")
  @@map("macro_observation_revisions")
}

/// Phase 5E (R3-A) - Ingestion job run history for scheduled ingestion orchestration./// logical_job_key is the attempt-independent job identity
/// (e.g. MARKET_QUOTES_DAILY:2026-10-19). attempt is history metadata only.
/// Active-run exclusivity is enforced by a PostgreSQL advisory lock held for the
/// whole execution (multi-instance safe, no in-memory mutex, no SELECT-then-INSERT).
model IngestionJobRunRecord {
  id                      String    @id @default(uuid()) @db.Uuid
  logicalJobKey           String    @map("logical_job_key") @db.VarChar(255)
  jobType                 String    @map("job_type") @db.VarChar(64)
  triggerType             String    @map("trigger_type") @db.VarChar(32)
  targetPeriod            String    @map("target_period") @db.VarChar(16)
  targetPeriodGranularity String    @map("target_period_granularity") @db.VarChar(16)
  scheduledFor            DateTime  @map("scheduled_for") @db.Date
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime? @map("finished_at") @db.Timestamptz(6)
  status                  String    @db.VarChar(32)
  attempt                 Int       @default(1)
  itemsRequested          Int?      @map("items_requested")
  itemsFetched            Int?      @map("items_fetched")
  itemsInserted           Int?      @map("items_inserted")
  itemsRevised            Int?      @map("items_revised")
  itemsUnchanged          Int?      @map("items_unchanged")
  itemsFailed             Int       @default(0) @map("items_failed")
  errorCode               String?   @map("error_code") @db.VarChar(64)
  errorMessage            String?   @map("error_message") @db.Text
  metadata                Json?     @map("metadata") @db.JsonB
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([logicalJobKey, attempt], map: "ingestion_job_runs_logical_key_attempt_uniq")
  @@index([logicalJobKey], map: "ingestion_job_runs_logical_key_idx")
  @@index([jobType, scheduledFor], map: "ingestion_job_runs_job_type_scheduled_for_idx")
  @@index([jobType, targetPeriod], map: "ingestion_job_runs_job_type_target_period_idx")
  @@index([status], map: "ingestion_job_runs_status_idx")
  @@index([startedAt], map: "ingestion_job_runs_started_at_idx")
  @@map("ingestion_job_runs")
}

/// Phase 5S-C — append-only transaction rectification link (identity + audit only).
/// One row asserts that a human rectified an original transaction: the
/// ledger keeps the original, its compensating reversal and (except for
/// pure cancellations) the replacement. Never updates or deletes any
/// transaction; replay nets out through the compensating leg. One outgoing
/// rectification per original (pair chain A→B→C via successive rows).
/// Replacements are always freshly created in the rectification flow,
/// so cycles are structurally impossible. No raw provider payloads.
model TransactionRectificationRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  portfolioId          String   @map("portfolio_id") @db.Uuid
  originalTransactionId String  @map("original_transaction_id") @db.Uuid
  compensatingTransactionId String @map("compensating_transaction_id") @db.Uuid
  replacementTransactionId String? @map("replacement_transaction_id") @db.Uuid
  mode                 String   @db.VarChar(20)
  reason               String   @db.VarChar(500)
  decidedByPrincipal   String   @map("decided_by_principal") @db.VarChar(255)
  decidedAt            DateTime @map("decided_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  portfolio     Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  original      Transaction @relation("RectificationOriginal", fields: [originalTransactionId], references: [id], onDelete: Restrict)
  compensating  Transaction @relation("RectificationCompensating", fields: [compensatingTransactionId], references: [id], onDelete: Restrict)
  replacement   Transaction? @relation("RectificationReplacement", fields: [replacementTransactionId], references: [id], onDelete: Restrict)

  @@unique([originalTransactionId], map: "transaction_rectification_original_uniq")
  @@unique([compensatingTransactionId], map: "transaction_rectification_compensating_uniq")
  @@unique([replacementTransactionId], map: "transaction_rectification_replacement_uniq")
  @@index([portfolioId], map: "transaction_rectification_portfolio_idx")
  @@map("transaction_rectifications")
}

/// Phase 5G - Operational alert event (dedupe + lifecycle, never financial).
/// At most one ACTIVE row per dedupe_key (code-enforced via advisory lock).
/// Resolution flips status to RESOLVED (history preserved, never deleted).
model OperationalAlertEventRecord {
  id              String    @id @default(uuid()) @db.Uuid
  dedupeKey       String    @map("dedupe_key") @db.VarChar(255)
  alertType       String    @map("alert_type") @db.VarChar(64)
  severity        String    @db.VarChar(16)
  source          String    @db.VarChar(64)
  status          String    @db.VarChar(16)
  reasonCode      String    @map("reason_code") @db.VarChar(64)
  firstDetectedAt DateTime  @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt  DateTime  @map("last_detected_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  occurrenceCount Int       @default(1) @map("occurrence_count")
  metadata        Json?     @map("metadata") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dedupeKey, status], map: "operational_alert_events_dedupe_status_idx")
  @@index([status], map: "operational_alert_events_status_idx")
  @@index([alertType], map: "operational_alert_events_alert_type_idx")
  @@index([lastDetectedAt], map: "operational_alert_events_detected_at_idx")
  @@map("operational_alert_events")
}

/// Phase 5S-B-R1 — Human reconciliation decision (identity + decision + audit only).
/// One row asserts that a human reviewed the pair (integration run source
/// item, local transaction): CONFIRM_MATCH records correspondence,
/// NOT_A_MATCH records rejection. Never creates, edits or deletes
/// ledger transactions; never rewrites run reconciliation summaries.
/// Identity is (portfolio, run, source item key, transaction): decisions
/// are run-scoped and idempotent per pair. No update or delete path:
/// a conflicting decision is rejected, never overwritten. Raw provider
/// payloads, secrets and credentials are never stored here.
model ReconciliationDecisionRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  portfolioId         String   @map("portfolio_id") @db.Uuid
  integrationRunId    String   @map("integration_run_id") @db.Uuid
  source              String   @db.VarChar(50)
  sourceItemKey       String   @map("source_item_key") @db.VarChar(255)
  localTransactionId  String   @map("local_transaction_id") @db.Uuid
  decision            String   @db.VarChar(20)
  decidedByPrincipal  String   @map("decided_by_principal") @db.VarChar(255)
  decidedAt           DateTime @map("decided_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  portfolio   Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  run         IntegrationRun   @relation(fields: [integrationRunId], references: [id], onDelete: Cascade)
  transaction Transaction      @relation(fields: [localTransactionId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, integrationRunId, sourceItemKey, localTransactionId], map: "reconciliation_decision_pair_uniq")
  @@index([integrationRunId], map: "reconciliation_decision_run_idx")
  @@map("reconciliation_decisions")
}


/// Phase 5T — Investor Asset Watchlist.
/// User-scoped watchlist for asset tracking and market intelligence discovery.
/// Idempotent via (userId, assetId) unique constraint.
model WatchlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId], map: "watchlist_items_user_asset_uniq")
  @@index([userId], map: "watchlist_items_user_idx")
  @@index([assetId], map: "watchlist_items_asset_idx")
  @@map("watchlist_items")
}

/// Phase 6B — LGPD & Legal Document Acceptance
/// Versioned acceptance tracking for Terms of Service and Privacy Policy.
model LegalDocumentAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentType    String   @map("document_type") @db.VarChar(50)
  documentVersion String   @map("document_version") @db.VarChar(20)
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  clientIp        String?  @map("client_ip") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "legal_doc_acceptances_user_idx")
  @@index([documentType, documentVersion], map: "legal_doc_acceptances_doc_ver_idx")
  @@map("legal_document_acceptances")
}

/// Phase 6B — LGPD User Consents
/// Granular consent tracking with explicit grant and revocation timestamps.
model UserConsent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String    @db.VarChar(100)
  granted   Boolean   @default(false)
  grantedAt DateTime? @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  clientIp  String?   @map("client_ip") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose], map: "user_consents_user_purpose_uniq")
  @@index([userId], map: "user_consents_user_idx")
  @@map("user_consents")
}

/// Phase 6B — LGPD Data Subject Requests (DSR)
/// Formal tracking of investor data rights requests (access, export, rectification, deletion, anonymization, revocation).
model DataSubjectRequest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(50)
  status         String    @default("PENDING") @db.VarChar(50)
  details        String?   @db.VarChar(2000)
  responseNotes  String?   @map("response_notes") @db.VarChar(2000)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "dsr_user_idx")
  @@index([status], map: "dsr_status_idx")
  @@map("data_subject_requests")
}

/// Cost-basis evidence revisions (ADR-310). Audited claims that
/// already-represented quantities carry factual acquisition cost. NEVER a
/// ledger event: no quantity is created, moved, or rewritten here.
/// Same content resubmitted is idempotent via the fingerprint identity;
/// content revisions insert new rows pointing at supersedesId (current =
/// rows nothing supersedes). Status transitions DRAFT → REVIEW_REQUIRED →
/// VERIFIED / REJECTED; only VERIFIED rows feed derived reads.
model CostBasisEvidenceRecord {
  id               String    @id @default(uuid()) @db.Uuid
  portfolioId      String    @map("portfolio_id") @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  evidenceType     String    @map("evidence_type") @db.VarChar(40)
  source           String    @db.VarChar(30)
  quantityCovered  Decimal   @map("quantity_covered") @db.Decimal(38, 18)
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(38, 18)
  totalCost        Decimal?  @map("total_cost") @db.Decimal(38, 18)
  currency         String    @db.VarChar(3)
  acquisitionDate  DateTime  @map("acquisition_date") @db.Date
  evidenceDate     DateTime? @map("evidence_date") @db.Date
  status           String    @db.VarChar(20)
  sourceReference  String    @map("source_reference") @db.VarChar(255)
  notes            String?   @db.Text
  version          Int       @default(1)
  supersedesId     String?   @map("supersedes_id") @db.Uuid
  fingerprint      String    @db.VarChar(64)
  confirmedBy      String?   @map("confirmed_by") @db.VarChar(255)
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedReason   String?   @map("rejected_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId, portfolioId], references: [id, portfolioId], onDelete: Restrict)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, fingerprint, version], name: "cost_evidence_fingerprint_version_identity")
  @@index([portfolioId, accountId, assetId, status], map: "cost_evidence_scope_status_idx")
  @@map("cost_basis_evidence")
}

/// APP-16M — Portfolio-scoped news intelligence baseline & refresh watermark.
/// Tracks when novelty tracking was initialized for a portfolio so existing
/// historical events do not generate a flood of false NEW alerts on rollout.
model PortfolioNewsSyncState {
  portfolioId            String    @id @map("portfolio_id") @db.Uuid
  newsStateInitializedAt DateTime? @map("news_state_initialized_at") @db.Timestamptz(6)
  lastRefreshedAt        DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_news_sync_states")
}

/// APP-16M — Per-portfolio canonical news event novelty, version fingerprint, and seen status.
/// Scoped strictly by (portfolioId, canonicalEventId) with CASCADE delete on portfolio.
model PortfolioNewsEventStateRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  portfolioId         String    @map("portfolio_id") @db.Uuid
  canonicalEventId    String    @map("canonical_event_id") @db.VarChar(120)
  firstSeenAt         DateTime  @map("first_seen_at") @db.Timestamptz(6)
  lastObservedAt      DateTime  @map("last_observed_at") @db.Timestamptz(6)
  lastSeenByUserAt    DateTime? @map("last_seen_by_user_at") @db.Timestamptz(6)
  firstFingerprint    String    @map("first_fingerprint") @db.VarChar(64)
  latestFingerprint   String    @map("latest_fingerprint") @db.VarChar(64)
  state               String    @db.VarChar(20)
  latestUpdateReasons Json      @default("[]") @map("latest_update_reasons")
  eventPublishedAt    DateTime? @map("event_published_at") @db.Timestamptz(6)
  snapshotMeta        Json      @default("{}") @map("snapshot_meta")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, canonicalEventId], map: "portfolio_news_event_states_portfolio_canonical_key")
  @@index([portfolioId, state], map: "portfolio_news_event_states_portfolio_state_idx")
  @@index([portfolioId, lastObservedAt(sort: Desc)], map: "portfolio_news_event_states_portfolio_observed_idx")
  @@index([portfolioId, eventPublishedAt(sort: Desc)], map: "portfolio_news_event_states_portfolio_published_idx")
  @@map("portfolio_news_event_states")
}
