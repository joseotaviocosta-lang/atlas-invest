/// Phase 5D — Official Calendar Days.
/// Distinguishes open trading/banking sessions from weekends and official holidays.
model CalendarDayRecord {
  id           String   @id @default(uuid()) @db.Uuid
  calendarType String   @map("calendar_type") @db.VarChar(32)
  date         DateTime @map("date") @db.Date
  isOpen       Boolean  @map("is_open")
  reason       String?  @map("reason") @db.VarChar(255)
  source       String   @map("source") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([calendarType, date], map: "calendar_days_type_date_uniq")
  @@index([calendarType, date], map: "calendar_days_type_date_idx")
  @@index([date], map: "calendar_days_date_idx")
  @@map("calendar_days")
}

