datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  name            String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  locale          String    @default("pt-BR") @db.VarChar(10)
  timezone        String    @default("America/Sao_Paulo") @db.VarChar(50)
  baseCurrency    String    @default("BRL") @map("base_currency") @db.VarChar(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolios          Portfolio[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  aiConversations     AiConversation[]
  taxTradeClassifications TaxTradeClassificationRecord[]
  taxWithholdingInputs    TaxWithholdingInputRecord[]
  fiiTaxEligibilityFacts  FiiTaxEligibilityFactRecord[]
  taxObligations          TaxObligationRecord[]
  taxPaymentEvidence      TaxPaymentEvidenceRecord[]
  taxCarryForwardEntries  TaxCarryForwardEntry[]
  taxPaymentAggregations  TaxPaymentAggregation[]
  taxpayerIdentity        TaxpayerIdentityRecord?
  darfGenerationRecords   OfficialDarfGenerationRecord[]
  taxCompensationElections TaxCompensationElectionRecord[]
  annualOpeningPositions  AnnualOpeningPositionInputRecord[]
  taxpayerConfirmations   TaxpayerConfirmationRecord[]
  highIncomeEvidence      HighIncomeEvidenceRecord[]
  taxComplianceActions    TaxComplianceActionRecord[]
  taxSettlementRecords    TaxSettlementRecord[]

  @@map("users")
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @map("refresh_token_hash") @db.VarChar(255)
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(255)
  usedRefreshTokenHashes   String[]  @default([]) @map("used_refresh_token_hashes")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent                String?   @map("user_agent") @db.VarChar(500)
  ipHash                   String?   @map("ip_hash") @db.VarChar(64)
  deviceName               String?   @map("device_name") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  country   String   @db.VarChar(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@map("institutions")
}

model Portfolio {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  baseCurrency String   @map("base_currency") @db.VarChar(3)
  type         String   @db.VarChar(50)
  status       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        Account[]
  transactions    Transaction[]
  aiConversations AiConversation[]
  annualOpeningPositions AnnualOpeningPositionInputRecord[]

  @@index([userId])
  @@map("portfolios")
}

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String   @db.VarChar(255)
  currency      String   @db.VarChar(3)
  status        String   @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio   Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  institution Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  annualOpeningPositions AnnualOpeningPositionInputRecord[]

  @@unique([id, portfolioId])
  @@index([portfolioId])
  @@index([institutionId])
  @@map("accounts")
}

model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  ticker    String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  currency  String   @db.VarChar(3)
  exchange  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions            Transaction[]
  marketIntelligenceLinks MarketIntelligenceAssetLink[]
  fiiTaxEligibilityFacts  FiiTaxEligibilityFactRecord[]
  annualOpeningPositions  AnnualOpeningPositionInputRecord[]

  @@unique([ticker, exchange])
  @@index([ticker])
  @@map("assets")
}

model Transaction {
  id             String    @id @default(uuid()) @db.Uuid
  portfolioId    String    @map("portfolio_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  assetId        String?   @map("asset_id") @db.Uuid
  type           String    @db.VarChar(50)
  tradeDate      DateTime  @map("trade_date") @db.Date
  settlementDate DateTime? @map("settlement_date") @db.Date
  source         String    @default("MANUAL") @db.VarChar(50)
  quantity       Decimal?  @db.Decimal(38, 18)
  unitPrice      Decimal?  @map("unit_price") @db.Decimal(38, 18)
  amount         Decimal?  @db.Decimal(38, 18)
  currency       String    @db.VarChar(3)
  fees           Decimal?  @db.Decimal(38, 18)
  taxes          Decimal?  @db.Decimal(38, 18)
  factor         Decimal?  @db.Decimal(38, 18)
  provider       String?   @db.VarChar(100)
  externalId     String?   @map("external_id") @db.VarChar(255)
  notes          String?   @db.Text
  transferGroupId String?  @map("transfer_group_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId, portfolioId], references: [id, portfolioId], onDelete: Restrict)
  asset     Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  taxTradeClassifications TaxTradeClassificationRecord[]

  @@unique([portfolioId, provider, externalId], name: "portfolio_provider_external_id_unique")
  @@index([portfolioId, tradeDate, createdAt, id])
  @@index([portfolioId, accountId])
  @@index([portfolioId, transferGroupId])
  @@index([assetId])
  @@map("transactions")
}

model AiConversation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  title       String?   @db.VarChar(255)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio   Portfolio              @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  messages    AiConversationMessage[]

  @@index([userId])
  @@index([portfolioId])
  @@index([portfolioId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  role              String    @db.VarChar(20)
  content           String    @db.Text
  status            String    @default("ANSWERED") @db.VarChar(50)
  intent            String?   @db.VarChar(100)
  evidenceSnapshot  Json?     @map("evidence_snapshot") @db.JsonB
  claims            Json?     @map("claims") @db.JsonB
  limitations       String[]  @default([]) @map("limitations")
  provider          String?   @db.VarChar(100)
  model             String?   @db.VarChar(100)
  providerRequestId String?   @map("provider_request_id") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("ai_conversation_messages")
}

model MarketIntelligenceItem {
  id             String   @id @default(uuid()) @db.Uuid
  sourceProvider String   @map("source_provider") @db.VarChar(100)
  sourceType     String   @map("source_type") @db.VarChar(50)
  sourceItemId   String   @map("source_item_id") @db.VarChar(255)
  headline       String   @db.VarChar(500)
  excerpt        String?  @db.VarChar(2000)
  canonicalUrl   String?  @map("canonical_url") @db.VarChar(1000)
  publishedAt    DateTime @map("published_at") @db.Timestamptz(6)
  retrievedAt    DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  category       String   @db.VarChar(50)
  language       String   @default("pt-BR") @db.VarChar(10)
  status         String   @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assetLinks MarketIntelligenceAssetLink[]

  @@unique([sourceProvider, sourceItemId], name: "source_provider_item_id_unique")
  @@index([publishedAt])
  @@index([category])
  @@map("market_intelligence_items")
}

model MarketIntelligenceAssetLink {
  id                       String   @id @default(uuid()) @db.Uuid
  marketIntelligenceItemId String   @map("market_intelligence_item_id") @db.Uuid
  assetId                  String   @map("asset_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item  MarketIntelligenceItem @relation(fields: [marketIntelligenceItemId], references: [id], onDelete: Cascade)
  asset Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([marketIntelligenceItemId, assetId], name: "item_asset_link_unique")
  @@index([assetId])
  @@index([marketIntelligenceItemId])
  @@map("market_intelligence_asset_links")
}

/// Phase 4B.3 — persisted canonical trade classification (auxiliary tax input).
/// References the immutable transaction; never mutates it.
model TaxTradeClassificationRecord {
  id              String    @id @default(uuid()) @db.Uuid
  taxSubjectId    String    @map("tax_subject_id") @db.Uuid
  transactionId   String    @map("transaction_id") @db.Uuid
  classification  String    @db.VarChar(20)
  sourceType      String    @map("source_type") @db.VarChar(50)
  sourceReference String    @map("source_reference") @db.VarChar(255)
  effectiveDate   DateTime  @map("effective_date") @db.Date
  status          String    @db.VarChar(20)
  conflictStatus  String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint     String    @db.VarChar(64)
  provenance      Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject  User        @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, transactionId, sourceReference], name: "tax_trade_classification_identity")
  @@index([taxSubjectId, transactionId])
  @@index([taxSubjectId, effectiveDate])
  @@map("tax_trade_classification_records")
}

/// Phase 4B.3 — persisted canonical withholding/IRRF input (exact decimal).
model TaxWithholdingInputRecord {
  id              String    @id @default(uuid()) @db.Uuid
  taxSubjectId    String    @map("tax_subject_id") @db.Uuid
  competence      String    @db.Char(7)
  economicDate    DateTime  @map("economic_date") @db.Date
  category        String    @db.VarChar(50)
  withholdingCategory String? @map("withholding_category") @db.VarChar(30)
  amount          Decimal?  @db.Decimal(38, 18)
  currency        String    @db.VarChar(3)
  status          String    @db.VarChar(20)
  sourceType      String    @map("source_type") @db.VarChar(50)
  sourceReference String    @map("source_reference") @db.VarChar(255)
  conflictStatus  String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint     String    @db.VarChar(64)
  provenance      Json
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, sourceType, sourceReference], name: "tax_withholding_identity")
  @@index([taxSubjectId, competence])
  @@index([taxSubjectId, economicDate])
  @@map("tax_withholding_input_records")
}

/// Phase 4B.3 — persisted FII tax-condition metadata (factual input only).
/// User-attested facts scoped to the tax subject; never tax treatment.
model FiiTaxEligibilityFactRecord {
  id                       String    @id @default(uuid()) @db.Uuid
  taxSubjectId             String    @map("tax_subject_id") @db.Uuid
  assetId                  String    @map("asset_id") @db.Uuid
  asOfDate                 DateTime  @map("as_of_date") @db.Date
  holderCount              Int?      @map("holder_count")
  investorOwnershipPercent Decimal?  @map("investor_ownership_percent") @db.Decimal(38, 18)
  isExchangeTraded         Boolean?  @map("is_exchange_traded")
  sourceType               String    @map("source_type") @db.VarChar(50)
  sourceReference          String    @map("source_reference") @db.VarChar(255)
  status                   String    @db.VarChar(20)
  conflictStatus           String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  fingerprint              String    @db.VarChar(64)
  provenance               Json
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User  @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, assetId, sourceType, sourceReference, asOfDate], name: "fii_tax_eligibility_identity")
  @@index([taxSubjectId, assetId, asOfDate])
  @@map("fii_tax_eligibility_fact_records")
}

/// Phase 4C.2 — official federal tax deadline registry (direct authority).
/// Reference data seeded from the official RFB Agenda Tributária / ADE CORAT.
/// Immutable/versioned: a Receita correction creates a new version and marks the
/// previous one SUPERSEDED (ADR-262, ADR-263). At most one active VERIFIED entry
/// per (revenue_code, competence) is enforced by a partial unique index in the
/// migration.
model FederalTaxDeadlineEntry {
  id                String   @id @default(uuid()) @db.Uuid
  revenueCode       String   @map("revenue_code") @db.VarChar(10)
  taxBucket         String   @map("tax_bucket") @db.VarChar(30)
  competence        String   @db.Char(7)
  dueDate           DateTime @map("due_date") @db.Date
  status            String   @db.VarChar(20)
  sourceAuthority   String   @map("source_authority") @db.VarChar(100)
  sourceDocument    String   @map("source_document") @db.VarChar(200)
  sourceReference   String   @map("source_reference") @db.VarChar(500)
  sourcePublishedAt DateTime @map("source_published_at") @db.Date
  verifiedAt        DateTime @map("verified_at") @db.Date
  version           Int
  supersedesEntryId String?  @map("supersedes_entry_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  obligations TaxObligationRecord[]

  @@unique([revenueCode, competence, version], name: "federal_tax_deadline_version_identity")
  @@index([revenueCode, competence, status])
  @@map("federal_tax_deadline_entries")
}

/// Phase 4C.2 — derived operational tax obligation. Never recalculates tax.
/// Materialized from a canonical MonthlyTaxLiability + a verified deadline entry
/// (ADR-264). Immutable per revision; liability changes supersede the previous
/// revision (ADR-267).
model TaxObligationRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  taxSubjectId         String    @map("tax_subject_id") @db.Uuid
  competence           String    @db.Char(7)
  taxBucket            String?   @map("tax_bucket") @db.VarChar(30)
  revenueCode          String?   @map("revenue_code") @db.VarChar(10)
  liabilityFingerprint String    @map("liability_fingerprint") @db.VarChar(64)
  revision             Int
  deadlineEntryId      String?   @map("deadline_entry_id") @db.Uuid
  principalAmount      Decimal?  @map("principal_amount") @db.Decimal(38, 18)
  currency             String?   @db.VarChar(3)
  dueDate              DateTime? @map("due_date") @db.Date
  status               String    @db.VarChar(30)
  reasonCode           String?   @map("reason_code") @db.VarChar(50)
  darfReadiness        String    @map("darf_readiness") @db.VarChar(20)
  darfReadinessReason  String?   @map("darf_readiness_reason") @db.VarChar(50)
  dataQuality          String    @map("data_quality") @db.VarChar(20)
  supersededById       String?   @map("superseded_by_id") @db.Uuid
  provenance           Json
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject    User                      @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  deadlineEntry FederalTaxDeadlineEntry?  @relation(fields: [deadlineEntryId], references: [id])
  payments      TaxPaymentEvidenceRecord[]
  carryForwardSources TaxCarryForwardEntry[]  @relation("CarryForwardSource")
  paymentAggregations TaxPaymentAggregation[] @relation("AggregationCurrentObligation")
  darfGenerationRecords OfficialDarfGenerationRecord[] @relation("DarfGenerationObligation")

  @@unique([taxSubjectId, competence, liabilityFingerprint, revision], name: "tax_obligation_identity")
  @@index([taxSubjectId, competence])
  @@index([taxSubjectId, status])
  @@map("tax_obligations")
}

/// Phase 4C.2 — manual payment evidence (operational only). Never mutates the
/// tax liability (ADR-266). `MANUAL_CONFIRMED` is the only supported source.
model TaxPaymentEvidenceRecord {
  id              String   @id @default(uuid()) @db.Uuid
  obligationId    String   @map("obligation_id") @db.Uuid
  taxSubjectId    String   @map("tax_subject_id") @db.Uuid
  paidAt          DateTime @map("paid_at") @db.Date
  amount          Decimal  @db.Decimal(38, 18)
  currency        String   @db.VarChar(3)
  sourceType      String   @map("source_type") @db.VarChar(30)
  sourceReference String?  @map("source_reference") @db.VarChar(255)
  confirmedAt     DateTime @map("confirmed_at") @db.Timestamptz(6)
  status          String   @db.VarChar(20)
  fingerprint     String   @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  obligation TaxObligationRecord @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  taxSubject User                @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([obligationId, sourceReference], name: "tax_payment_evidence_source_identity")
  @@unique([obligationId, fingerprint], name: "tax_payment_evidence_fingerprint_identity")
  @@index([taxSubjectId, obligationId])
  @@map("tax_payment_evidence")
}

/// Phase 4D.2 — immutable official Sicalc late-fee snapshots. Authoritative for
/// the business-day-sensitive late-fee amount/percent (no generic holiday
/// calendar). Corrections create a new version (ADR-271).
model OfficialLateFeeSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  municipalityCode  String   @map("municipality_code") @db.VarChar(10)
  dueDate           DateTime @map("due_date") @db.Date
  paymentDate       DateTime @map("payment_date") @db.Date
  principalAmount   Decimal  @map("principal_amount") @db.Decimal(38, 18)
  lateFeeAmount     Decimal  @map("late_fee_amount") @db.Decimal(38, 18)
  lateFeePercent    Decimal  @map("late_fee_percent") @db.Decimal(38, 18)
  startBusinessDate DateTime? @map("start_business_date") @db.Date
  sourceSystem      String   @map("source_system") @db.VarChar(30)
  sourceReference   String   @map("source_reference") @db.VarChar(500)
  sourceRetrievedAt DateTime @map("source_retrieved_at") @db.Timestamptz(6)
  verifiedAt        DateTime @map("verified_at") @db.Timestamptz(6)
  version           Int
  fingerprint       String   @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([municipalityCode, dueDate, paymentDate, principalAmount, version], name: "official_late_fee_snapshot_identity")
  @@index([municipalityCode, dueDate, paymentDate])
  @@map("official_late_fee_snapshots")
}

/// Phase 4D.2 — immutable official monthly SELIC rate snapshots. Source: RFB
/// Sicalc/RFB acts only; missing rate fails closed (ADR-272).
model TaxInterestRateSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  indexName       String   @map("index_name") @db.VarChar(30)
  referenceMonth  String   @map("reference_month") @db.Char(7)
  ratePercent     Decimal  @map("rate_percent") @db.Decimal(38, 18)
  sourceAuthority String   @map("source_authority") @db.VarChar(100)
  sourceReference String   @map("source_reference") @db.VarChar(500)
  sourceRetrievedAt DateTime @map("source_retrieved_at") @db.Timestamptz(6)
  verifiedAt      DateTime @map("verified_at") @db.Timestamptz(6)
  version         Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([indexName, referenceMonth, version], name: "tax_interest_rate_snapshot_identity")
  @@index([indexName, referenceMonth])
  @@map("tax_interest_rate_snapshots")
}

/// Phase 4E - deferred sub-minimum federal tax amounts (immutable facts).
/// A below-minimum obligation produces an `OPEN` entry; it is consumed exactly
/// once when the accumulated same-revenue-code total reaches the minimum
/// (ADR-279, ADR-281). Corrections supersede the entry, never rewrite history.
model TaxCarryForwardEntry {
  id                      String    @id @default(uuid()) @db.Uuid
  taxSubjectId            String    @map("tax_subject_id") @db.Uuid
  sourceObligationId      String    @map("source_obligation_id") @db.Uuid
  sourceCompetence        String    @map("source_competence") @db.Char(7)
  revenueCode             String    @map("revenue_code") @db.VarChar(10)
  currency                String    @db.VarChar(3)
  amount                  Decimal   @db.Decimal(38, 18)
  status                  String    @db.VarChar(20)
  targetCompetence        String?   @map("target_competence") @db.Char(7)
  consumedByAggregationId String?   @map("consumed_by_aggregation_id") @db.Uuid
  consumedAt              DateTime? @map("consumed_at") @db.Timestamptz(6)
  ruleId                  String    @map("rule_id") @db.VarChar(100)
  ruleVersion             String    @map("rule_version") @db.VarChar(30)
  fingerprint             String    @db.VarChar(64)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject            User                  @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  sourceObligation      TaxObligationRecord   @relation("CarryForwardSource", fields: [sourceObligationId], references: [id], onDelete: Cascade)
  consumedByAggregation TaxPaymentAggregation? @relation("AggregationConsumedEntries", fields: [consumedByAggregationId], references: [id])

  @@unique([sourceObligationId, ruleId, ruleVersion], name: "tax_carry_forward_source_identity")
  @@index([taxSubjectId, revenueCode, status])
  @@index([taxSubjectId, revenueCode, targetCompetence])
  @@map("tax_carry_forward_entries")
}

/// Phase 4E - derived payment aggregation unit (current competence + open
/// same-code carry-forward). Never recalculates tax (ADR-279, ADR-280).
model TaxPaymentAggregation {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  revenueCode         String    @map("revenue_code") @db.VarChar(10)
  targetCompetence    String    @map("target_competence") @db.Char(7)
  currency            String    @db.VarChar(3)
  currentAmount       Decimal   @map("current_amount") @db.Decimal(38, 18)
  carryForwardAmount  Decimal   @map("carry_forward_amount") @db.Decimal(38, 18)
  totalPayable        Decimal   @map("total_payable") @db.Decimal(38, 18)
  minimumThreshold    Decimal   @map("minimum_threshold") @db.Decimal(38, 18)
  sourceEntryIds      Json      @map("source_entry_ids")
  currentObligationId String?   @map("current_obligation_id") @db.Uuid
  dueDate             DateTime? @map("due_date") @db.Date
  status              String    @db.VarChar(20)
  ruleId              String    @map("rule_id") @db.VarChar(100)
  ruleVersion         String    @map("rule_version") @db.VarChar(30)
  fingerprint         String    @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject        User                   @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  currentObligation TaxObligationRecord?   @relation("AggregationCurrentObligation", fields: [currentObligationId], references: [id])
  consumedEntries   TaxCarryForwardEntry[] @relation("AggregationConsumedEntries")

  @@unique([taxSubjectId, revenueCode, targetCompetence, fingerprint], name: "tax_payment_aggregation_identity")
  @@index([taxSubjectId, revenueCode, targetCompetence])
  @@map("tax_payment_aggregations")
}

/// Phase 4F - taxpayer identity boundary. Stores ONLY a masked display form and
/// an opaque HMAC reference; the raw CPF/CNPJ is never persisted (ADR-286).
model TaxpayerIdentityRecord {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  identityType      String   @map("identity_type") @db.VarChar(10)
  maskedIdentifier  String   @map("masked_identifier") @db.VarChar(30)
  secureReference   String   @map("secure_reference") @db.VarChar(64)
  identityAvailable Boolean  @map("identity_available")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taxpayer_identities")
}

/// Phase 4F - immutable official DARF generation/handoff record. Atlas does not
/// generate the official document; the record captures the prepared handoff and
/// its provenance. GENERATED is never equivalent to PAID (ADR-287, ADR-288).
model OfficialDarfGenerationRecord {
  id                      String    @id @default(uuid()) @db.Uuid
  taxSubjectId            String    @map("tax_subject_id") @db.Uuid
  taxObligationId         String?   @map("tax_obligation_id") @db.Uuid
  taxPaymentAggregationId String?   @map("tax_payment_aggregation_id") @db.Uuid
  generationMode          String    @map("generation_mode") @db.VarChar(40)
  revenueCode             String    @map("revenue_code") @db.VarChar(10)
  competence              String    @db.Char(7)
  dueDate                 DateTime? @map("due_date") @db.Date
  principalAmount         Decimal   @map("principal_amount") @db.Decimal(38, 18)
  lateFeeAmount           Decimal?  @map("late_fee_amount") @db.Decimal(38, 18)
  interestAmount          Decimal?  @map("interest_amount") @db.Decimal(38, 18)
  totalAmount             Decimal   @map("total_amount") @db.Decimal(38, 18)
  currency                String    @db.VarChar(3)
  officialDocumentId      String?   @map("official_document_id") @db.VarChar(100)
  officialReference       String?   @map("official_reference") @db.VarChar(255)
  sourceSystem            String    @map("source_system") @db.VarChar(40)
  status                  String    @db.VarChar(30)
  version                 Int
  fingerprint             String    @db.VarChar(64)
  supersededById          String?   @map("superseded_by_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject    User                 @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  taxObligation TaxObligationRecord? @relation("DarfGenerationObligation", fields: [taxObligationId], references: [id])

  @@unique([taxSubjectId, taxObligationId, fingerprint], name: "official_darf_generation_identity")
  @@index([taxSubjectId, status])
  @@index([taxSubjectId, taxObligationId])
  @@map("official_darf_generation_records")
}

/// Phase 4G.2A.1a - persisted, immutable tax-compensation election revisions.
/// One logical election identity is `(taxSubjectId, competence, electionType)`;
/// each change inserts a new monotonic `version` (never an in-place update).
/// Same value is idempotent. Source is `MANUAL_CONFIRMED` only.
model TaxCompensationElectionRecord {
  id           String   @id @default(uuid()) @db.Uuid
  taxSubjectId String   @map("tax_subject_id") @db.Uuid
  competence   String   @db.Char(7)
  electionType String   @map("election_type") @db.VarChar(60)
  value        String   @db.VarChar(30)
  version      Int
  source       String   @db.VarChar(30)
  supersedesId String?  @map("supersedes_id") @db.Uuid
  fingerprint  String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, competence, electionType, version], name: "tax_compensation_election_revision_identity")
  @@index([taxSubjectId, competence, electionType])
  @@map("tax_compensation_elections")
}

/// Phase 4H.2 - canonical opening position input record for pre-Atlas holdings.
/// One logical identity is `(taxSubjectId, portfolioId, accountId, assetId, revision)`.
/// Superseded records maintain full audit history.
model AnnualOpeningPositionInputRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  portfolioId         String    @map("portfolio_id") @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  assetId             String    @map("asset_id") @db.Uuid
  effectiveDate       DateTime  @map("effective_date") @db.Date
  quantity            Decimal   @db.Decimal(38, 18)
  totalHistoricalCost Decimal   @map("total_historical_cost") @db.Decimal(38, 18)
  currency            String    @db.VarChar(3)
  source              String    @db.VarChar(40)
  status              String    @db.VarChar(30)
  revision            Int
  fingerprint         String    @db.VarChar(64)
  notes               String?   @db.Text
  supersedesId        String?   @map("supersedes_id") @db.Uuid
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User      @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)
  portfolio  Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([taxSubjectId, portfolioId, accountId, assetId, revision], name: "annual_opening_position_revision_identity", map: "annual_opening_pos_rev_uniq")
  @@index([taxSubjectId, portfolioId, accountId, assetId, status], map: "annual_opening_pos_lookup_idx")
  @@index([taxSubjectId, status], map: "annual_opening_pos_subj_status_idx")
  @@map("annual_opening_position_inputs")
}

/// Phase 4H.5 - persisted, audited taxpayer confirmations for annual tax readiness.
/// Captures taxpayer declarations (e.g. FII eligibility, dividend transition, opening positions, withholding).
/// Monotonic revision increments on updates; stale confirmations are detected if sourceFingerprint changes.
model TaxpayerConfirmationRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  taxSubjectId       String    @map("tax_subject_id") @db.Uuid
  calendarYear       Int       @map("calendar_year")
  confirmationType   String    @map("confirmation_type") @db.VarChar(60)
  subjectReference   String    @map("subject_reference") @db.VarChar(255)
  decision           String    @db.VarChar(30)
  statementVersion   String    @map("statement_version") @db.VarChar(30)
  sourceFingerprint  String    @map("source_fingerprint") @db.VarChar(64)
  source             String    @db.VarChar(50)
  createdByPrincipal String    @map("created_by_principal") @db.VarChar(255)
  revision           Int
  fingerprint        String    @db.VarChar(64)
  supersedesId       String?   @map("supersedes_id") @db.Uuid
  notes              String?   @db.Text
  confirmedAt        DateTime  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, calendarYear, confirmationType, subjectReference, revision], name: "taxpayer_confirmation_revision_identity", map: "taxpayer_conf_rev_uniq")
  @@index([taxSubjectId, calendarYear, confirmationType, subjectReference], map: "taxpayer_conf_lookup_idx")
  @@index([taxSubjectId, calendarYear], map: "taxpayer_conf_year_idx")
  @@map("taxpayer_confirmations")
}

/// Phase 4I.4 - persisted high-income annual evidence (corporate effective-tax facts,
/// annual adjustment attestations, attested annual-income totals).
/// Only non-derivable evidence facts are stored; every calculation remains derived.
/// Monotonic revision increments; conflicting candidates fail closed until resolved.
model HighIncomeEvidenceRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  taxSubjectId        String    @map("tax_subject_id") @db.Uuid
  calendarYear        Int       @map("calendar_year")
  payerKey            String    @map("payer_key") @db.VarChar(255)
  payerId             String?   @map("payer_id") @db.VarChar(255)
  evidenceType        String    @map("evidence_type") @db.VarChar(40)
  payerType           String?   @map("payer_type") @db.VarChar(40)
  profitPeriodExercise Int?     @map("profit_period_exercise")
  evidenceMode        String?   @map("evidence_mode") @db.VarChar(20)
  accountingProfit    Decimal?  @map("accounting_profit") @db.Decimal(38, 18)
  irDue               Decimal?  @map("ir_due") @db.Decimal(38, 18)
  csllDue             Decimal?  @map("csll_due") @db.Decimal(38, 18)
  prouniTaxCredit     Decimal?  @map("prouni_tax_credit") @db.Decimal(38, 18)
  simplifiedRevenue   Decimal?  @map("simplified_revenue") @db.Decimal(38, 18)
  adjustmentAmount    Decimal?  @map("adjustment_amount") @db.Decimal(38, 18)
  authority           String    @db.VarChar(30)
  evidenceSource      String    @map("evidence_source") @db.VarChar(40)
  conflictStatus      String    @default("NONE") @map("conflict_status") @db.VarChar(20)
  upstreamFingerprint String?   @map("upstream_fingerprint") @db.VarChar(64)
  sourceFingerprint   String    @map("source_fingerprint") @db.VarChar(64)
  revision            Int
  fingerprint         String    @db.VarChar(64)
  supersedesId        String?   @map("supersedes_id") @db.Uuid
  resolutionNote      String?   @map("resolution_note") @db.VarChar(40)
  createdByPrincipal  String    @map("created_by_principal") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, calendarYear, payerKey, evidenceType, profitPeriodExercise, revision], name: "high_income_evidence_revision_identity", map: "hi_evidence_rev_uniq")
  @@index([taxSubjectId, calendarYear, evidenceType, payerKey], map: "hi_evidence_lookup_idx")
  @@index([taxSubjectId, calendarYear], map: "hi_evidence_year_idx")
  @@map("high_income_evidence_records")
}

/// Phase 4K.1 - persisted, audited taxpayer compliance workflow actions.
/// Captures user-reported actions (e.g. completion, dismissal, acknowledgment)
/// for operational compliance obligations without mutating tax calculations.
/// Monotonic revision increments on updates; stale actions are detected if sourceFingerprint changes.
model TaxComplianceActionRecord {
  id                String    @id @default(uuid()) @db.Uuid
  taxSubjectId      String    @map("tax_subject_id") @db.Uuid
  obligationKey     String    @map("obligation_key") @db.VarChar(255)
  actionType        String    @map("action_type") @db.VarChar(50)
  sourceFingerprint String?   @map("source_fingerprint") @db.VarChar(64)
  note              String?   @db.Text
  metadata          Json?
  revision          Int       @default(1)
  occurredAt        DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, obligationKey, revision], name: "tax_compliance_action_revision_identity", map: "tax_compliance_action_rev_uniq")
  @@index([taxSubjectId, obligationKey], map: "tax_compliance_action_lookup_idx")
  @@index([taxSubjectId, occurredAt], map: "tax_compliance_action_time_idx")
  @@map("tax_compliance_actions")
}

/// Phase 4K.2 — user-reported external payment evidence / settlement record.
/// Immutable per revision; stale if underlying obligation sourceFingerprint changes (ADR-286).
model TaxSettlementRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  taxSubjectId        String   @map("tax_subject_id") @db.Uuid
  obligationKey       String   @map("obligation_key") @db.VarChar(255)
  sourceFingerprint   String   @map("source_fingerprint") @db.VarChar(64)
  revision            Int      @default(1)
  paymentDate         DateTime @map("payment_date") @db.Date
  amountReported      Decimal  @map("amount_reported") @db.Decimal(38, 18)
  revenueCodeReported String?  @map("revenue_code_reported") @db.VarChar(16)
  referencePeriod     String   @map("reference_period") @db.VarChar(16)
  externalReference   String?  @map("external_reference") @db.VarChar(255)
  note                String?  @db.Text
  verificationStatus  String   @default("USER_REPORTED") @map("verification_status") @db.VarChar(32)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxSubject User @relation(fields: [taxSubjectId], references: [id], onDelete: Cascade)

  @@unique([taxSubjectId, obligationKey, revision], name: "tax_settlement_record_revision_identity", map: "tax_settlement_record_rev_uniq")
  @@index([taxSubjectId, obligationKey], map: "tax_settlement_record_lookup_idx")
  @@index([taxSubjectId, referencePeriod], map: "tax_settlement_record_period_idx")
  @@map("tax_settlement_records")
}