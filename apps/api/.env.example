# Atlas API - Production Environment Configuration
PORT=3001
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/atlas_prod?schema=public"

# Security & Authentication (Required: at least 32 characters in production)
JWT_ACCESS_SECRET="generate-at-least-32-random-characters-secret-here"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER="generate-at-least-32-random-characters-pepper-here"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_PEPPER="generate-at-least-32-random-characters-pepper-here"
PASSWORD_RESET_TTL_MINUTES=15

# Access Control & CORS
ALLOWED_ORIGINS="https://app.yourdomain.com"
ALLOW_PUBLIC_REGISTRATION=false

# Observability & Versioning
APP_VERSION="0.1.0"
GIT_COMMIT_SHA="production"

