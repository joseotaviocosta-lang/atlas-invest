{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/database": "workspace:*",
    "@atlas/domain": "workspace:*",
    "@atlas/logger": "workspace:*",
    "@atlas/benchmark-engine": "workspace:*",
    "@atlas/market-data": "workspace:*",
    "@atlas/performance-engine": "workspace:*",
    "@atlas/risk-engine": "workspace:*",
    "@atlas/scenario-engine": "workspace:*",
    "@atlas/portfolio-intelligence": "workspace:*",
    "@atlas/portfolio-engine": "workspace:*",
    "@atlas/valuation-engine": "workspace:*",
    "@atlas/ai-engine": "workspace:*",
    "@atlas/tax-engine": "workspace:*",
    "@atlas/validation": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
