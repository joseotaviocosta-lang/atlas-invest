# Atlas Web App - Production Environment Configuration
PORT=3000
NODE_ENV=production

# Application URL (used for origin validation and secure redirect contracts)
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"

# Public API URL (for client-side reference where applicable)
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# Backend API URL (consumed server-side by Next.js BFF Route Handlers)
API_BASE_URL="http://atlas-api:3001"

