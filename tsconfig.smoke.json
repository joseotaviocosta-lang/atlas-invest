{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@atlas/domain": ["packages/domain/src/index.ts"],
      "@atlas/benchmark-engine": ["packages/benchmark-engine/src/index.ts"],
      "@atlas/market-data": ["packages/market-data/src/index.ts"],
      "@atlas/valuation-engine": ["packages/valuation-engine/src/index.ts"],
      "@atlas/performance-engine": ["packages/performance-engine/src/index.ts"],
      "@atlas/risk-engine": ["packages/risk-engine/src/index.ts"],
      "@atlas/scenario-engine": ["packages/scenario-engine/src/index.ts"],
      "@atlas/portfolio-intelligence": ["packages/portfolio-intelligence/src/index.ts"],
      "@atlas/portfolio-engine": ["packages/portfolio-engine/src/index.ts"],
      "@atlas/tax-engine": ["packages/tax-engine/src/index.ts"],
      "@atlas/ai-engine": ["packages/ai-engine/src/index.ts"],
      "@atlas/news-data": ["packages/news-data/src/index.ts"],
      "@atlas/database": ["packages/database/src/index.ts"],
      "@atlas/logger": ["packages/logger/src/index.ts"],
      "@atlas/testing": ["packages/testing/src/index.ts"],
      "@atlas/ui": ["packages/ui/src/index.ts"],
      "@atlas/validation": ["packages/validation/src/index.ts"]
    }
  }
}
