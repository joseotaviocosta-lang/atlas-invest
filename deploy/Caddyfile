# ============================================================================
# Project Atlas — Reverse Proxy (Caddyfile)
# Architecture: ADR-290 (Linux VPS + Reverse Proxy)
#
# Supported Modes:
# 1. Controlled Hostname Mode (HTTPS with automated ACME/Let's Encrypt)
#    Activated when PILOT_API_DOMAIN is defined (e.g. api.yourdomain.com)
# 2. Temporary IP-Only Mode (HTTP only on static IPv4 without TLS)
# ============================================================================
{
	email {$CADDY_EMAIL:ops@localhost}
}

# Common security headers applied to all environments
(common_security_headers) {
	header {
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# Modern referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Permissions policy
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Hide Caddy server signature
		-Server
	}
}

# HTTPS-only security headers (Strict-Transport-Security)
# RFC 6797 §7.2: An HTTP host MUST NOT send an HSTS header over plain HTTP.
(https_security_headers) {
	import common_security_headers
	header {
		# Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
}

# Backwards compatibility alias for default security headers
(security_headers) {
	import common_security_headers
}

# ----------------------------------------------------------------------------
# Controlled Hostname HTTPS API (Pilot / Production)
# Activated when PILOT_API_DOMAIN is set (e.g. api.ownerdomain.com)
# ----------------------------------------------------------------------------
{$PILOT_API_DOMAIN} {
	import https_security_headers
	encode zstd gzip

	@api_routes path /api/v1/* /docs* /health /ready
	handle @api_routes {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:3001
	}

	# Fallback response for unrouted requests
	handle {
		respond "Atlas API Gateway — Not Found" 404
	}
}

# ----------------------------------------------------------------------------
# Staging IP-Only HTTP Access (Temporary fallback)
# ----------------------------------------------------------------------------
http://{$STAGING_HOST:54.233.66.110} {
	import common_security_headers
	encode zstd gzip

	# Route API routes to NestJS
	@api_routes path /api/v1/* /docs* /health /ready
	handle @api_routes {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:3001
	}

	# Route all other requests (Web Next.js: /login, /today, /portfolio, /api/auth/* BFF, _next/*)
	handle {
		reverse_proxy web:3000
	}
}
